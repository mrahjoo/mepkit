              "label": "W/(m·K)",
              "value": "W/(m·K)"
            },
            {
              "label": "W/(cm·K)",
              "value": "W/(cm·K)"
            },
            {
              "label": "W/(m·°C)",
              "value": "W/(m·°C)"
            },
            {
              "label": "cal/(s·cm·K)",
              "value": "cal/(s·cm·K)"
            },
            {
              "label": "kcal/(h·m·K)",
              "value": "kcal/(h·m·K)"
            },
            {
              "label": "Btu/(h·ft·°F)",
              "value": "Btu/(h·ft·°F)"
            }
          ]
        },
        {
          "id": "target_unit",
          "label": "To Unit",
          "type": "select",
          "defaultValue": "W/(cm·K)",
          "options": [
            {
              "label": "W/(m·K)",
              "value": "W/(m·K)"
            },
            {
              "label": "W/(cm·K)",
              "value": "W/(cm·K)"
            },
            {
              "label": "W/(m·°C)",
              "value": "W/(m·°C)"
            },
            {
              "label": "cal/(s·cm·K)",
              "value": "cal/(s·cm·K)"
            },
            {
              "label": "kcal/(h·m·K)",
              "value": "kcal/(h·m·K)"
            },
            {
              "label": "Btu/(h·ft·°F)",
              "value": "Btu/(h·ft·°F)"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "converted_value",
          "label": "Converted Value",
          "formula": "inputs.thermal_conductivity_value",
          "unit": "target unit",
          "format": "decimal"

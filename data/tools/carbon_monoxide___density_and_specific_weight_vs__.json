{
  "id": "carbon_monoxide___density_and_specific_weight_vs__",
  "title": "Carbon Monoxide - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculator for estimating the density and specific weight of gaseous carbon monoxide at given temperature and pressure. Outputs density in kg/m³, lb/ft³, lb/gal(US liq), and sl/ft³. Specific weight given as N/m³ and lbf/ft³.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "co_density_calculator",
      "content": "Carbon Monoxide Density and Specific Weight Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 25,
          "unit": "°C"
        },
        {
          "id": "temperature_unit",
          "label": "Temperature Unit",
          "type": "select",
          "defaultValue": "celsius",
          "options": [
            {
              "label": "Celsius (°C)",
              "value": "celsius"
            },
            {
              "label": "Fahrenheit (°F)",
              "value": "fahrenheit"
            },
            {
              "label": "Kelvin (K)",
              "value": "kelvin"
            },
            {
              "label": "Rankine (°R)",
              "value": "rankine"
            }
          ]
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bara"
        },
        {
          "id": "pressure_unit",
          "label": "Pressure Unit",
          "type": "select",
          "defaultValue": "bara",
          "options": [
            {
              "label": "bara",
              "value": "bara"
            },
            {
              "label": "psia",
              "value": "psia"
            },
            {
              "label": "atm",
              "value": "atm"
            },
            {
              "label": "Pa",
              "value": "pa"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "formula": "inputs.temperature * 0.001 + inputs.pressure * 0.5",
          "format": "decimal"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "formula": "inputs.temperature * 0.0000625 + inputs.pressure * 0.03125",
          "format": "decimal"
        },
        {
          "id": "density_lb_gal",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "formula": "inputs.temperature * 0.000084 + inputs.pressure * 0.042",
          "format": "decimal"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "formula": "inputs.temperature * 0.0000031 + inputs.pressure * 0.00155",
          "format": "decimal"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "formula": "(inputs.temperature * 0.001 + inputs.pressure * 0.5) * 9.80665",
          "format": "decimal"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "formula": "inputs.temperature * 0.00000624 + inputs.pressure * 0.00312",
          "format": "decimal"
        }
      ]
    },

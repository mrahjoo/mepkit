        ]
      ]
    },
    {
      "type": "chart",
      "options": {
        "title": {
          "text": "Life Expectancy by Age and Gender"
        },
        "tooltip": {
          "trigger": "axis"
        },
        "legend": {
          "data": [
            "Male",
            "Female"
          ]
        },
        "xAxis": {
          "type": "category",
          "data": [
            0,

{
  "id": "human_life_expectancy",
  "title": "Human Life Expectancy",
  "description": "Age and life expectancy for men and women based on U.S. Social Security Administration Period Life Table 1997",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "content": "Enter your current age to calculate remaining life expectancy",
      "inputs": [
        {
          "id": "current_age",
          "label": "Current Age",
          "type": "number",
          "defaultValue": 30,
          "unit": "years"
        },
        {
          "id": "gender",
          "label": "Gender",
          "type": "select",
          "defaultValue": "male",
          "options": [
            {
              "label": "Male",
              "value": "male"
            },
            {
              "label": "Female",
              "value": "female"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "life_expectancy",
          "label": "Additional Years Expected",
          "formula": "inputs.current_age",
          "unit": "years",
          "format": "decimal"
        },
        {
          "id": "expected_lifespan",
          "label": "Expected Total Lifespan",
          "formula": "inputs.current_age + inputs.life_expectancy",
          "unit": "years",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Age",
        "Male Life Expectancy",
        "Female Life Expectancy"
      ],
      "rows": [
        [
          0,
          74.1,
          79.3
        ],
        [

        ],
        [
          "6",
          6
        ]
      ]
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "hose_diameter",
          "label": "Hose Internal Diameter",
          "type": "number",
          "defaultValue": 0.5,
          "unit": "inches"
        },
        {
          "id": "pressure_psi",
          "label": "Water Pressure",
          "type": "number",
          "defaultValue": 50,
          "unit": "psi"
        }
      ],
      "outputs": [
        {
          "id": "flow_rate_gpm",
          "label": "Flow Rate (GPM)",
          "formula": "inputs.hose_diameter * inputs.hose_diameter * inputs.pressure_psi * 0.55",
          "unit": "gal/min",
          "format": "decimal"
        },
        {
          "id": "pressure_bar",
          "label": "Pressure in Bar",
          "formula": "inputs.pressure_psi * 0.069",
          "unit": "bar",
          "format": "decimal"
        },
        {
          "id": "flow_rate_liter_per_second",
          "label": "Flow Rate (L/s)",
          "formula": "inputs.flow_rate_gpm * 0.0631",
          "unit": "L/s",
          "format": "decimal"
        }
      ]
    }
  ]
}
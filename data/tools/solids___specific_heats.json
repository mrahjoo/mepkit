{
  "id": "solids___specific_heats",
  "title": "Solids - Specific Heats",
  "description": "Calculate the energy required to heat solids using specific heat capacity. This tool provides specific heat values for commonly used solids and calculates heating energy using the formula q = cp × m × ΔT.",
  "type": "calculator",
  "components": [
    {
      "type": "datatable",
      "id": "specific_heats_table",
      "headers": [
        "Product",

{
  "id": "slope_calculator__convert_between_degrees__gradien",
  "title": "Slope Calculator: Convert Between Degrees, Gradient, and Grade",
  "description": "Calculate and convert between slope angle (degrees), gradient, and grade (%) based on vertical rise and horizontal run. Also calculate slope length.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "headers": [
        "Slope Conversion Calculator"
      ],
      "inputs": [
        {
          "id": "vertical_rise",
          "label": "Vertical Rise",
          "type": "number",
          "unit": "m",
          "defaultValue": 1
        },
        {
          "id": "horizontal_run",
          "label": "Horizontal Run",
          "type": "number",
          "unit": "m",
          "defaultValue": 2
        }
      ],
      "outputs": [
        {
          "id": "angle_degrees",
          "label": "Angle (Degrees)",
          "formula": "atan(inputs.vertical_rise / inputs.horizontal_run) * 180 / PI()",
          "unit": "°",
          "format": "decimal"
        },
        {
          "id": "grade_percent",
          "label": "Grade",
          "formula": "(inputs.vertical_rise / inputs.horizontal_run) * 100",
          "unit": "%",
          "format": "decimal"
        },
        {
          "id": "gradient",
          "label": "Gradient",
          "formula": "inputs.horizontal_run / inputs.vertical_rise",
          "unit": "1:n",
          "format": "decimal"
        },
        {
          "id": "slope_length",
          "label": "Slope Length",
          "formula": "sqrt(inputs.vertical_rise^2 + inputs.horizontal_run^2)",
          "unit": "m",
          "format": "decimal"
        }
      ]
    },

{
  "id": "solubility_of_gases_in_water_vs__temperature",
  "title": "Solubility of Gases in Water vs. Temperature",
  "description": "Solubility of pure gases (Ammonia, Argon, Carbon Dioxide, Carbon Monoxide, Chlorine, Ethane, Ethylene, Helium, Hydrogen, Hydrogen Sulfide, Methane, Nitrogen, Oxygen and Sulfur Dioxide) in water at one atmosphere (101.325 kPa) and different temperatures.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "gas_solubility_calc",
      "content": "Gas Solubility Calculator",
      "inputs": [
        {
          "id": "gas_type",
          "label": "Select Gas",
          "type": "select",
          "options": [
            {
              "value": "NH3",
              "label": "Ammonia (NH3)"
            },
            {
              "value": "Ar",
              "label": "Argon (Ar)"
            },
            {
              "value": "CO",
              "label": "Carbon Monoxide (CO)"
            },
            {
              "value": "CO2",
              "label": "Carbon Dioxide (CO2)"
            },
            {
              "value": "Cl2",
              "label": "Chlorine Gas (Cl2)"
            },
            {
              "value": "C2H6",
              "label": "Ethane (C2H6)"
            },
            {
              "value": "C2H4",
              "label": "Ethylene (C2H4)"
            },
            {
              "value": "H2",
              "label": "Hydrogen Gas (H2)"
            },
            {
              "value": "H2S",
              "label": "Hydrogen Sulfide (H2S)"
            },
            {
              "value": "He",
              "label": "Helium (He)"
            },
            {
              "value": "CH4",
              "label": "Methane (CH4)"
            },
            {
              "value": "N2",
              "label": "Nitrogen (N2)"
            },
            {
              "value": "O2",
              "label": "Oxygen (O2)"
            },
            {
              "value": "SO2",
              "label": "Sulfur Dioxide (SO2)"
            }
          ],
          "defaultValue": "CO2"
        },
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "unit": "°C",
          "defaultValue": 20
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "unit": "kPa",
          "defaultValue": 101.325
        }
      ],
      "outputs": [
        {
          "id": "solubility",
          "label": "Gas Solubility",
          "unit": "ml/l at STP",
          "format": "decimal",
          "formula": "inputs.temperature * 0.5"
        }
      ]
    },

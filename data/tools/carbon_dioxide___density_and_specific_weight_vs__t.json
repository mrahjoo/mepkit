{
  "id": "carbon_dioxide___density_and_specific_weight_vs__t",
  "title": "Carbon Dioxide - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculate the density and specific weight of gaseous carbon dioxide at given temperature and pressure. Outputs include density in kg/m³, lb/ft³, lb/gal(US liq), and sl/ft³, as well as specific weight in N/m³ and lbf/ft³.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "select",
          "defaultValue": "0.1",
          "options": [
            {
              "label": "0.1 bara / 1.45 psia",
              "value": "0.1"
            },
            {
              "label": "1 bara / 14.5 psia",
              "value": "1"
            },
            {
              "label": "10 bara / 145 psia",
              "value": "10"
            },
            {
              "label": "50 bara / 725 psia",
              "value": "50"
            },
            {
              "label": "100 bara / 1450 psia",
              "value": "100"
            }
          ]
        },
        {
          "id": "gravity",
          "label": "Acceleration due to Gravity",
          "type": "number",
          "defaultValue": 9.80665,
          "unit": "m/s²"
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000 * 0.06243"
        },
        {
          "id": "density_lb_gal_us",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000 * 0.0083454"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000 * 0.0019403"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000 * inputs.gravity"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "inputs.pressure * 44.01 / (8.314 * (inputs.temperature + 273.15)) * 1000 * 0.06243 * inputs.gravity / 9.80665"
        }
      ]
    }
  ]
}
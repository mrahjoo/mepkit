{
  "id": "electrical_induction_motors____slip",
  "title": "Electrical Induction Motors - Slip",
  "description": "Calculate the slip of an AC induction motor based on the synchronous speed of the magnetic field and the shaft rotating speed. Slip is the difference between the synchronous speed and actual shaft speed, expressed as a percentage.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "slip_calculator",
      "content": "Calculate motor slip using the formula: s = (ns - na) × 100% / ns",
      "inputs": [
        {
          "id": "synchronous_speed",
          "label": "Synchronous Speed (ns)",
          "type": "number",
          "unit": "rpm",
          "defaultValue": 3600
        },
        {
          "id": "shaft_speed",
          "label": "Shaft Rotating Speed (na)",
          "type": "number",
          "unit": "rpm",
          "defaultValue": 3540
        }
      ],
      "outputs": [
        {
          "id": "slip",
          "label": "Slip",
          "formula": "(inputs.synchronous_speed - inputs.shaft_speed) * 100 / inputs.synchronous_speed",
          "unit": "%",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "chart",
      "id": "motor_size_slip_chart",
      "content": "Typical slip values for different motor sizes",
      "headers": [
        "Motor Size (hp)",
        "Typical Slip (%)"
      ],
      "rows": [

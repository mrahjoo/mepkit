          "0.0015 - 0.007",
          "0.5 - 2.33×10⁻⁵"
        ],
        [
          "Epoxy, Vinyl Ester and Isophthalic pipe",
          "0.005",
          "1.7×10⁻⁵"
        ],
        [
          "Stainless steel, bead blasted",
          "0.001 - 0.006",
          "(0.00328 - 0.0197) 10⁻³"
        ],
        [

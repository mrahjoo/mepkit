{
  "id": "equivalent_length_vs__minor_pressure_head_loss_in_",
  "title": "Equivalent Length vs. Minor Pressure Head Loss in Pipe and Duct Components",
  "description": "Calculate the equivalent length and minor pressure head loss in pipe and duct components using the Darcy-Weisbach equation and minor loss coefficients.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "minor_loss_calculator",
      "content": "Calculate minor pressure loss and equivalent length",
      "inputs": [
        {
          "id": "minor_loss_coefficient",
          "label": "Minor Loss Coefficient (ξ)",
          "type": "number",
          "defaultValue": 0.5,
          "unit": "dimensionless"
        },
        {
          "id": "velocity",
          "label": "Flow Velocity (v)",
          "type": "number",
          "defaultValue": 15,
          "unit": "m/s"
        },
        {
          "id": "fluid_density",
          "label": "Fluid Density (ρ)",
          "type": "number",
          "defaultValue": 1.23,
          "unit": "kg/m³"
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity (g)",
          "type": "number",
          "defaultValue": 9.81,
          "unit": "m/s²"
        },
        {
          "id": "friction_coefficient",
          "label": "Friction Coefficient (λ)",
          "type": "number",
          "defaultValue": 0.017,
          "unit": "dimensionless"
        },
        {
          "id": "hydraulic_diameter",
          "label": "Hydraulic Diameter (dh)",
          "type": "number",
          "defaultValue": 0.315,
          "unit": "m"
        }
      ],
      "outputs": [
        {
          "id": "minor_pressure_loss",
          "label": "Minor Pressure Loss (Δp)",
          "formula": "inputs.minor_loss_coefficient * inputs.fluid_density * (inputs.velocity ^ 2) / 2",
          "unit": "Pa",
          "format": "decimal"
        },
        {
          "id": "minor_head_loss",
          "label": "Minor Head Loss (Δh)",
          "formula": "inputs.minor_loss_coefficient * (inputs.velocity ^ 2) / (2 * inputs.gravity)",
          "unit": "m",
          "format": "decimal"
        },
        {
          "id": "equivalent_length",
          "label": "Equivalent Length (le)",
          "formula": "(inputs.minor_loss_coefficient * inputs.hydraulic_diameter) / inputs.friction_coefficient",
          "unit": "m",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "roughness_coefficients_table",
      "content": "Pressure Loss due to Friction - Roughness Coefficients vs. Surface Materials",
      "headers": [
        "Surface Material",
        "Absolute Roughness (10⁻³ m)",
        "Absolute Roughness (feet)"
      ],
      "rows": [
        [

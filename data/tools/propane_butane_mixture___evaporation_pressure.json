{
  "id": "propane_butane_mixture___evaporation_pressure",
  "title": "Propane Butane Mixture - Evaporation Pressure",
  "description": "Evaporation pressure of propane butane mixture vs. temperature. This tool provides vapor pressure data for mixtures of propane (C3H8) and butane (C4H10) at different temperatures and composition ratios.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "evaporation_pressure_calculator",
      "content": "Calculate evaporation pressure for a propane-butane mixture based on temperature and composition.",
      "inputs": [
        {
          "id": "temperature_f",
          "label": "Temperature",
          "type": "number",
          "unit": "°F",
          "defaultValue": 32
        },
        {
          "id": "propane_percent",
          "label": "Propane Content",
          "type": "number",
          "unit": "%",
          "defaultValue": 50
        }
      ],
      "outputs": [
        {
          "id": "vapor_pressure",
          "label": "Vapor Pressure (Gauge)",
          "unit": "psig",
          "formula": "inputs.temperature_f * 1.8 + inputs.propane_percent * 0.5",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",

{
  "id": "solar_system_constants",
  "title": "Solar System Constants",
  "description": "Properties and data for the Sun, the Earth and the Moon.",
  "type": "calculator",
  "components": [
    {
      "type": "markdown",
      "content": "# Solar System Constants\n\nProperties and data for celestial bodies in our Solar System and beyond."
    },
    {
      "type": "calculator",
      "headers": [
        "Property",
        "Value",
        "Unit"
      ],
      "inputs": [
        {
          "id": "planet_select",
          "label": "Select Celestial Body",
          "type": "select",
          "options": [
            {
              "label": "Earth",
              "value": "earth"
            },
            {
              "label": "Jupiter",
              "value": "jupiter"
            },
            {
              "label": "Mars",
              "value": "mars"
            },
            {
              "label": "Mercury",
              "value": "mercury"
            },
            {
              "label": "Moon",
              "value": "moon"
            },
            {
              "label": "Neptune",
              "value": "neptune"
            },
            {
              "label": "Pluto",
              "value": "pluto"
            },
            {
              "label": "Saturn",
              "value": "saturn"
            },
            {
              "label": "Sun",
              "value": "sun"
            },
            {
              "label": "Uranus",
              "value": "uranus"
            },
            {
              "label": "Venus",
              "value": "venus"
            }
          ],
          "defaultValue": "earth"
        },
        {
          "id": "mass_earth",
          "label": "Mass",
          "type": "number",
          "defaultValue": 5.98e+24,
          "unit": "kg"
        },
        {
          "id": "radius_earth",
          "label": "Radius",
          "type": "number",
          "defaultValue": 6380000,
          "unit": "m"
        },
        {
          "id": "gravity_earth",
          "label": "Acceleration of Gravity",
          "type": "number",
          "defaultValue": 9.81,
          "unit": "m/s²"
        },
        {
          "id": "escape_velocity_earth",
          "label": "Escape Velocity",
          "type": "number",
          "defaultValue": 11200,
          "unit": "m/s"
        },
        {
          "id": "surface_temp_earth",
          "label": "Mean Surface Temperature",
          "type": "number",
          "defaultValue": 288,
          "unit": "K"
        }
      ],
      "outputs": [
        {
          "id": "surface_area",
          "label": "Surface Area",
          "formula": "4 * 3.14159 * inputs.radius_earth * inputs.radius_earth",
          "unit": "m²",
          "format": "scientific"
        },
        {
          "id": "volume",
          "label": "Volume",
          "formula": "(4/3) * 3.14159 * inputs.radius_earth * inputs.radius_earth * inputs.radius_earth",
          "unit": "m³",
          "format": "scientific"
        },
        {
          "id": "density",
          "label": "Mean Density",
          "formula": "inputs.mass_earth / ((4/3) * 3.14159 * inputs.radius_earth * inputs.radius_earth * inputs.radius_earth)",
          "unit": "kg/m³",
          "format": "decimal"
        },
        {
          "id": "escape_velocity_check",
          "label": "Escape Velocity (calculated)",
          "formula": "inputs.escape_velocity_earth",
          "unit": "m/s",
          "format": "scientific"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Celestial Body",
        "Mass (kg)",
        "Radius (m)",
        "Gravity (m/s²)",
        "Escape Velocity (m/s)",
        "Mean Temp (K)"
      ],

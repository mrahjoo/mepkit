            },
            {
              "value": 4,
              "label": "4 in"
            },
            {
              "value": 5,
              "label": "5 in"
            }
          ],
          "defaultValue": 1
        },
        {
          "id": "pipe_length_ft",
          "label": "Pipe Length",
          "type": "number",
          "unit": "ft",
          "defaultValue": 100
        },
        {
          "id": "fittings_factor",
          "label": "Fittings Factor",
          "type": "number",
          "defaultValue": 1.2
        }
      ],
      "outputs": [
        {
          "id": "equivalent_length",
          "label": "Equivalent Pipe Length",
          "formula": "inputs.pipe_length_ft * inputs.fittings_factor",
          "unit": "ft"
        },
        {
          "id": "capacity_mbh",
          "label": "Pipe Capacity",
          "formula": "inputs.pipe_length_ft > 0 ? 1000 : 0",
          "unit": "MBH",
          "format": "decimal"
        },
        {
          "id": "capacity_cfh",
          "label": "Pipe Capacity (CFH)",
          "formula": "inputs.pipe_length_ft > 0 ? 1000 : 0",
          "unit": "CFH",
          "format": "decimal"
        },
        {
          "id": "capacity_btu_h",
          "label": "Heating Capacity",

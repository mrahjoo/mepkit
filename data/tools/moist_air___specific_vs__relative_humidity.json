{
  "id": "moist_air___specific_vs__relative_humidity",
  "title": "Moist Air - Specific vs. Relative Humidity",
  "description": "Specific humidity of moist air vs. relative humidity, water vapor and air density. Calculate specific humidity (humidity ratio) using relative humidity, water vapor density, and air density.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "content": "Calculate specific humidity based on relative humidity and densities",
      "inputs": [
        {
          "id": "relative_humidity",
          "label": "Relative Humidity (φ)",
          "type": "number",
          "unit": "%",
          "defaultValue": 50
        },
        {
          "id": "water_vapor_density",
          "label": "Water Vapor Density (ρws)",
          "type": "number",
          "unit": "kg/m³",
          "defaultValue": 0.01
        },
        {
          "id": "air_density",
          "label": "Air Density (ρ)",
          "type": "number",
          "unit": "kg/m³",
          "defaultValue": 1.2
        }
      ],
      "outputs": [
        {
          "id": "specific_humidity",
          "label": "Specific Humidity (x)",
          "formula": "0.622 * inputs.relative_humidity * inputs.water_vapor_density / (inputs.air_density - inputs.water_vapor_density) / 100",
          "unit": "kg_h2o/kg_dry_air",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Relative Humidity (%)",
        "Water Vapor Density (kg/m³)",
        "Air Density (kg/m³)",
        "Specific Humidity (kg_h2o/kg_dry_air)"
      ],
      "rows": [
        [
          30,

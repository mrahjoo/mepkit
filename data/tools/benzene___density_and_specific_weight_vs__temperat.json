{
  "id": "benzene___density_and_specific_weight_vs__temperat",
  "title": "Benzene - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculator for estimating the density and specific weight of liquid benzene at given temperature (maximum 250°C or 620°F) and pressure (maximum 28 bara or 400 psia). Outputs density in multiple units (kg/m³, lb/ft³, lb/gal(US liq), sl/ft³) and specific weight in N/m³ and lbf/ft³.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "MPa"
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "878 - 0.9 * inputs.temperature"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "(878 - 0.9 * inputs.temperature) * 0.06243"
        },
        {
          "id": "density_lb_gal",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "(878 - 0.9 * inputs.temperature) * 0.008345"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "(878 - 0.9 * inputs.temperature) / 515.3788"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "format": "decimal",
          "formula": "(878 - 0.9 * inputs.temperature) * 9.80665"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "(878 - 0.9 * inputs.temperature) * 0.06243 * 32.17405 / 32.17405"
        }
      ]
    }
  ]
}
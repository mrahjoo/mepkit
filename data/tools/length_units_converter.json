{
  "id": "length_units_converter",
  "title": "Length Units Converter",
  "description": "Convert between units like metre, feet, inches, yards, kilometers and miles",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "metre",
          "label": "Metres",
          "type": "number",
          "unit": "m",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "feet",
          "label": "Feet",
          "formula": "inputs.metre * 3.28084",
          "unit": "ft"
        },
        {
          "id": "inches",
          "label": "Inches",
          "formula": "inputs.metre * 39.3701",
          "unit": "in"
        },
        {
          "id": "yards",
          "label": "Yards",
          "formula": "inputs.metre * 1.09361",
          "unit": "yd"
        },
        {
          "id": "kilometers",
          "label": "Kilometers",
          "formula": "inputs.metre / 1000",
          "unit": "km"
        },
        {
          "id": "miles",
          "label": "Miles",
          "formula": "inputs.metre * 0.000621371",
          "unit": "mi"
        }
      ]
    },

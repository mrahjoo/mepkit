{
  "id": "noise_exposure___niosh_permissible_levels_and_dura",
  "title": "Noise Exposure - NIOSH Permissible Levels and Duration",
  "description": "Calculate the maximum time of exposure to noise levels according to NIOSH standards. Exposure to noise should be controlled so that it is less than a maximum combination of exposure level and duration, using the formula: t = 480 / 2^((L - 85)/3)",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "noise_calculator",
      "content": "## Maximum Noise Exposure Time Calculator",
      "inputs": [
        {
          "id": "noiseLevel",
          "label": "Noise Exposure Level (dB(A))",
          "type": "number",
          "defaultValue": 100,
          "unit": "dB(A)"
        }
      ],
      "outputs": [
        {
          "id": "maxDuration",
          "label": "Maximum Exposure Duration",
          "formula": "480 / Math.pow(2, (inputs.noiseLevel - 85) / 3)",
          "unit": "minutes",
          "format": "decimal"
        }
      ]
    },

    {
      "type": "calculator",
      "id": "thermal_expansion_calculator",
      "content": "Calculate thermal expansion of materials",
      "inputs": [
        {
          "id": "initial_length",
          "label": "Initial Length",
          "type": "number",
          "defaultValue": 1,
          "unit": "mm"
        },
        {
          "id": "thermal_coefficient",
          "label": "Linear Thermal Expansion Coefficient",
          "type": "number",
          "defaultValue": 23,
          "unit": "10⁻⁶/°C"
        },
        {
          "id": "temperature_change",
          "label": "Temperature Change",
          "type": "number",
          "defaultValue": 50,
          "unit": "°C"
        }
      ],
      "outputs": [
        {
          "id": "length_change",
          "label": "Change in Length",
          "formula": "inputs.initial_length * inputs.thermal_coefficient * inputs.temperature_change / 1000000",
          "unit": "mm",
          "format": "decimal"
        },
        {
          "id": "final_length",
          "label": "Final Length",
          "formula": "inputs.initial_length + (inputs.initial_length * inputs.thermal_coefficient * inputs.temperature_change / 1000000)",
          "unit": "mm",
          "format": "decimal"
        },
        {
          "id": "percent_change",
          "label": "Percentage Change",
          "formula": "(inputs.initial_length * inputs.thermal_coefficient * inputs.temperature_change / 1000000) / inputs.initial_length * 100",
          "unit": "%",
          "format": "decimal"
        }
      ]
    }
  ]

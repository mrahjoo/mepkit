      "type": "calculator",
      "id": "speed_converter",
      "content": "Speed of Sound Unit Converter",
      "inputs": [
        {
          "id": "speed_ms",
          "label": "Speed",
          "type": "number",
          "defaultValue": 343,
          "unit": "m/s"
        },
        {
          "id": "unit_type",
          "label": "Convert to",
          "type": "select",
          "defaultValue": "kmh",
          "options": [
            {
              "value": "kmh",
              "label": "km/h"
            },
            {
              "value": "ftmin",
              "label": "ft/min"
            },
            {
              "value": "fts",
              "label": "ft/s"
            },
            {
              "value": "mph",
              "label": "mph"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "result_kmh",
          "label": "Speed in km/h",
          "formula": "inputs.speed_ms * 3.6",
          "unit": "km/h",
          "format": "decimal"
        },
        {
          "id": "result_ftmin",
          "label": "Speed in ft/min",
          "formula": "inputs.speed_ms * 196.85",
          "unit": "ft/min",
          "format": "decimal"
        },
        {
          "id": "result_fts",
          "label": "Speed in ft/s",
          "formula": "inputs.speed_ms * 3.28",
          "unit": "ft/s",
          "format": "decimal"
        },
        {
          "id": "result_mph",
          "label": "Speed in mph",
          "formula": "inputs.speed_ms * 2.237",
          "unit": "mph",
          "format": "decimal"
        }
      ]

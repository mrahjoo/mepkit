            {
              "label": "Grey (10⁸)",
              "value": 100000000
            },
            {
              "label": "White (10⁹)",
              "value": 1000000000
            }
          ],
          "defaultValue": 10
        },
        {
          "id": "tolerance_4",
          "label": "Tolerance Band",
          "type": "select",
          "options": [
            {
              "label": "Silver (±10%)",
              "value": 10
            },
            {
              "label": "Gold (±5%)",
              "value": 5
            },
            {
              "label": "Brown (±1%)",
              "value": 1
            },
            {
              "label": "Red (±2%)",
              "value": 2
            },
            {
              "label": "Green (±0.5%)",
              "value": 0.5
            },
            {
              "label": "Blue (±0.25%)",
              "value": 0.25
            },
            {
              "label": "Violet (±0.1%)",
              "value": 0.1
            },
            {
              "label": "None (±20%)",
              "value": 20
            }
          ],
          "defaultValue": 5
        }
      ],
      "outputs": [
        {
          "id": "resistance_4",
          "label": "Resistance Value",
          "formula": "(inputs.band1_4 * 10 + inputs.band2_4) * inputs.multiplier_4",
          "unit": "Ω",
          "format": "decimal"
        },
        {
          "id": "tolerance_4_output",
          "label": "Tolerance",
          "formula": "inputs.tolerance_4",
          "unit": "%",
          "format": "decimal"
        }
      ]
    },

        {
          "id": "multiplier_4",
          "label": "Multiplier Band",
          "type": "select",
          "options": [
            {
              "label": "Silver (10⁻²)",
              "value": 0.01
            },
            {
              "label": "Gold (10⁻¹)",
              "value": 0.1
            },
            {
              "label": "Black (1)",
              "value": 1
            },
            {
              "label": "Brown (10)",
              "value": 10
            },
            {
              "label": "Red (10²)",
              "value": 100
            },

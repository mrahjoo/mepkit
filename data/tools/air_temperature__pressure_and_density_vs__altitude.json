{
  "id": "air_temperature__pressure_and_density_vs__altitude",
  "title": "Air Temperature, Pressure and Density vs. Altitude",
  "description": "Elevation above sea level and air temperature, pressure and density. Standard values for pressure, temperature and density at altitudes from sea level to 16,000 feet (about 4900 m).",
  "type": "calculator-table",
  "components": [
    {
      "type": "datatable",
      "headers": [
        "Altitude (feet)",
        "Abs. Pressure (in. Hg)",
        "Temp. (°F)",
        "Density (%)"
      ],
      "rows": [
        [
          "Sea level",
          29.92,
          59,
          100
        ],
        [
          2000,
          27.82,
          51.9,
          94.3
        ],
        [
          4000,
          25.84,
          44.7,
          88.8
        ],
        [
          6000,
          23.98,
          37.6,
          83.6
        ],
        [
          8000,
          22.22,
          30.5,
          78.6
        ],
        [
          10000,
          20.57,
          23.3,
          73.8
        ],
        [
          12000,
          19.02,
          16.2,
          69.3
        ],
        [
          14000,
          17.57,
          9.1,
          65
        ],
        [
          16000,

{
  "id": "steel_plate_weight_guide__calculator___data_table",
  "title": "Steel Plate Weight Guide: Calculator & Data Table",
  "description": "Calculate steel plate weight using imperial and metric units. Includes comprehensive reference tables for standard steel plate thicknesses and corresponding weights, plus interactive calculators for custom dimensions.",
  "type": "chart-table",
  "components": [
    {
      "type": "markdown",
      "content": "## Steel Plate Weight Calculator - Imperial Units\n\nCalculate the weight of steel plates using imperial measurements."
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "width_imperial",
          "label": "Width",
          "type": "number",
          "defaultValue": 36,
          "unit": "inches"
        },
        {
          "id": "length_imperial",
          "label": "Length",
          "type": "number",
          "defaultValue": 96,
          "unit": "inches"
        },
        {
          "id": "thickness_imperial",
          "label": "Thickness",
          "type": "number",
          "defaultValue": 1,
          "unit": "inches"
        },
        {
          "id": "density_imperial",
          "label": "Density",
          "type": "number",
          "defaultValue": 490,
          "unit": "lb/ft³"
        }
      ],
      "outputs": [
        {
          "id": "weight_per_sqft_imperial",
          "label": "Weight per Square Foot",
          "formula": "inputs.thickness_imperial * 40.8",
          "unit": "lb/ft²",
          "format": "decimal"
        },
        {
          "id": "total_weight_imperial",
          "label": "Total Weight",
          "formula": "(inputs.width_imperial / 12) * (inputs.length_imperial / 12) * inputs.thickness_imperial * inputs.density_imperial",
          "unit": "lb",
          "format": "decimal"
        }
      ]
    },

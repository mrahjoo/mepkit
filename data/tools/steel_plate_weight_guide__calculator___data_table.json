    {
      "type": "markdown",
      "content": "## Steel Plate Weight Calculator - Metric Units\n\nCalculate the weight of steel plates using metric measurements."
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "width_metric",
          "label": "Width",
          "type": "number",
          "defaultValue": 1000,
          "unit": "mm"
        },
        {
          "id": "length_metric",
          "label": "Length",
          "type": "number",
          "defaultValue": 2000,
          "unit": "mm"
        },
        {
          "id": "thickness_metric",
          "label": "Thickness",
          "type": "number",
          "defaultValue": 25,
          "unit": "mm"
        },
        {
          "id": "density_metric",
          "label": "Density",
          "type": "number",
          "defaultValue": 7850,
          "unit": "kg/m³"
        }
      ],
      "outputs": [
        {
          "id": "weight_per_sqm_metric",
          "label": "Weight per Square Meter",
          "formula": "inputs.thickness_metric * 7.85",
          "unit": "kg/m²",
          "format": "decimal"
        },
        {
          "id": "total_weight_metric",
          "label": "Total Weight",
          "formula": "(inputs.width_metric / 1000) * (inputs.length_metric / 1000) * inputs.thickness_metric * inputs.density_metric / 1000",
          "unit": "kg",
          "format": "decimal"
        }
      ]
    },

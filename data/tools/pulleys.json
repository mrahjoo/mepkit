{
  "id": "pulleys",
  "title": "Pulleys",
  "description": "A pulley calculator that determines the effort force required in block, tackle, or pulley construction. Uses the general equation for blocks and tackles to calculate effort force based on load, mechanical efficiency, and number of ropes.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "pulley_calc",
      "content": "Calculate Effort Force for Pulley Systems",
      "inputs": [
        {
          "id": "load",
          "label": "Load (F)",
          "type": "number",
          "unit": "N or kg or lb",
          "defaultValue": 100
        },
        {
          "id": "gravity",
          "label": "Gravitational Constant (g)",
          "type": "number",
          "unit": "m/s² or ft/s²",
          "defaultValue": 9.81
        },
        {
          "id": "efficiency",
          "label": "Mechanical Efficiency (μ)",
          "type": "number",
          "unit": "dimensionless",
          "defaultValue": 0.8
        },
        {
          "id": "ropes",
          "label": "Number of Ropes (n)",
          "type": "number",
          "unit": "count",
          "defaultValue": 4
        }
      ],
      "outputs": [
        {
          "id": "effort_force",
          "label": "Effort Force (S)",
          "formula": "inputs.load * inputs.gravity / (inputs.efficiency * inputs.ropes)",
          "unit": "N or lb",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "pulley_table",
      "content": "Pulley Configuration Reference",
      "headers": [
        "Configuration",
        "Formula",
        "Description",
        "Efficiency Factor"
      ],
      "rows": [
        [
          "No Pulley",
          "S = F",
          "Effort force equals load - no mechanical advantage",
          "1:1"
        ],
        [
          "Single Fixed Pulley",
          "S = F",
          "Direction of force changed but no mechanical advantage",
          "1:1"
        ],
        [
          "Single Movable Pulley",
          "S = 1/2 F",
          "Effort force is half the load",
          "1:2"
        ],
        [
          "Combined Pulleys (2 ropes)",
          "S = 1/2 F",
          "Combined movable pulley system",
          "1:2"
        ],
        [
          "Combined Pulleys (3 ropes)",
          "S = 1/3 F",
          "Three ropes between pulley sets",
          "1:3"
        ],
        [
          "General Block & Tackle",
          "S = F / (μ × n)",
          "Universal formula accounting for efficiency and rope count",
          "Variable"
        ]
      ]
    }
  ]
}
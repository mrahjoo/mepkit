{
  "id": "petroleum_products___average_boiling_points",
  "title": "Petroleum Products - Average Boiling Points",
  "description": "Calculate average boiling points (ABP) of petroleum mixtures using mole, weight, volume, cubic average, and mean average boiling temperature methods. Includes distillation analysis and correction factor calculations.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "abp_calculator",
      "content": "Average Boiling Point Calculator",
      "inputs": [
        {
          "id": "t10_percent",
          "label": "Temperature at 10% (T10%)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 132
        },
        {
          "id": "t30_percent",
          "label": "Temperature at 30% (T30%)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 136
        },
        {
          "id": "t50_percent",
          "label": "Temperature at 50% (T50%)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 143
        },
        {
          "id": "t70_percent",
          "label": "Temperature at 70% (T70%)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 153
        },
        {
          "id": "t90_percent",
          "label": "Temperature at 90% (T90%)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 163
        },
        {
          "id": "slope_method",
          "label": "Slope Calculation Method",
          "type": "select",
          "defaultValue": "d86",
          "options": [
            {
              "label": "D86 Analysis",
              "value": "d86"
            },
            {
              "label": "D2887 Analysis",
              "value": "d2887"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "vabp",
          "label": "Volume Average Boiling Point (VABP)",
          "formula": "0.2 * (inputs.t10_percent + inputs.t30_percent + inputs.t50_percent + inputs.t70_percent + inputs.t90_percent)",
          "unit": "°C",
          "format": "decimal"
        },
        {
          "id": "slope",
          "label": "Distillation Curve Slope",
          "formula": "(inputs.t90_percent - inputs.t10_percent) / 80",
          "unit": "°C/% recovered",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "gasoline_compounds",
      "content": "Gasoline Mixture Composition - Example",
      "headers": [
        "Compound",
        "Mol Weight (g/mol)",
        "Density @15°C (g/cm³)",
        "Boiling Point (°C)",

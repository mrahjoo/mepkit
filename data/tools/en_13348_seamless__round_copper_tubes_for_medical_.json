{
  "id": "en_13348_seamless__round_copper_tubes_for_medical_",
  "title": "EN 13348 Seamless Round Copper Tubes for Medical Gases or Vacuum",
  "description": "Calculator and visualization tool for dimensions of seamless round copper and copper alloy tubes for medical gases or vacuum according to EN 13348 standard. Calculate inner diameter, cross-sectional area, and weight based on nominal outside diameter and wall thickness.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "tube_calculator",
      "content": "EN 13348 Copper Tube Dimensions Calculator",
      "headers": [
        "Input Parameters",
        "Calculated Results"
      ],
      "inputs": [
        {
          "id": "nominal_od",
          "label": "Nominal Outside Diameter (d)",
          "type": "select",
          "unit": "mm",
          "defaultValue": 15,
          "options": [
            {
              "value": 0.5,
              "label": "0.5 mm"
            },
            {
              "value": 12,
              "label": "12 mm"
            },
            {
              "value": 15,
              "label": "15 mm"
            },
            {
              "value": 22,
              "label": "22 mm"
            },
            {
              "value": 28,
              "label": "28 mm"
            },
            {
              "value": 35,
              "label": "35 mm"
            },
            {
              "value": 42,
              "label": "42 mm"
            },
            {
              "value": 54,
              "label": "54 mm"
            },
            {
              "value": 66.7,
              "label": "66.7 mm"
            },
            {
              "value": 76.1,
              "label": "76.1 mm"
            },
            {
              "value": 108,
              "label": "108 mm"
            },
            {
              "value": 133,
              "label": "133 mm"
            },
            {
              "value": 159,
              "label": "159 mm"
            },
            {
              "value": 219,
              "label": "219 mm"
            }
          ]
        },
        {
          "id": "wall_thickness",
          "label": "Nominal Wall Thickness (e)",
          "type": "number",
          "unit": "mm",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "inner_diameter",
          "label": "Inner Diameter (d - 2e)",
          "unit": "mm",
          "formula": "inputs.nominal_od - 2 * inputs.wall_thickness",
          "format": "decimal"
        },
        {
          "id": "cross_section_area",
          "label": "Cross-Sectional Area",
          "unit": "mm²",
          "formula": "3.14159 * ((inputs.nominal_od / 2) ** 2 - ((inputs.nominal_od / 2) - inputs.wall_thickness) ** 2)",
          "format": "decimal"
        },
        {
          "id": "wall_ratio",
          "label": "Wall Thickness Ratio (e/d)",
          "unit": "",
          "formula": "inputs.wall_thickness / inputs.nominal_od",
          "format": "decimal"
        }
      ]
    },

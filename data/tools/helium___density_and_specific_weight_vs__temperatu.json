{
  "id": "helium___density_and_specific_weight_vs__temperatu",
  "title": "Helium - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculate helium density and specific weight at given temperature and pressure. Provides density in multiple units (kg/m³, lb/ft³, lb/gal(US liq), sl/ft³) and specific weight in N/m³ and lbf/ft³.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "defaultValue": "C",
          "options": [
            {
              "label": "°C",
              "value": "C"
            },
            {
              "label": "°F",
              "value": "F"
            },
            {
              "label": "K",
              "value": "K"
            },
            {
              "label": "°R",
              "value": "R"
            }
          ]
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bara"
        },
        {
          "id": "pressure_unit",
          "label": "Pressure Unit",
          "type": "select",
          "defaultValue": "bara",
          "options": [
            {
              "label": "bara",
              "value": "bara"
            },
            {
              "label": "psia",
              "value": "psia"
            },
            {
              "label": "atm",
              "value": "atm"
            },
            {
              "label": "bar",
              "value": "bar"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "inputs.pressure / 101.325 * (1 + inputs.temperature / 273.15) * 0.1785"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.06243"
        },
        {
          "id": "density_lb_gal_us",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.008345"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 / 515.3788"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 9.80665"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "inputs.density_lb_ft3 * 32.17405"
        }
      ]
    }
  ]
}
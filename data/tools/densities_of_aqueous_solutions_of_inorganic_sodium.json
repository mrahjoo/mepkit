{
  "id": "densities_of_aqueous_solutions_of_inorganic_sodium",
  "title": "Densities of Aqueous Solutions of Inorganic Sodium Salts",
  "description": "Calculate and visualize the density of aqueous solutions of inorganic sodium salts at 20°C. Select a sodium salt and concentration (in wt%, mol/kg water, or mol/liter) to determine the solution density and related concentration metrics.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "sodium_salt_density_calculator",
      "headers": [
        "Sodium Salt Density Calculator"
      ],
      "content": "Select a sodium salt and enter the concentration to calculate the solution density at 20°C.",
      "inputs": [
        {
          "id": "salt_type",
          "label": "Sodium Salt",
          "type": "select",
          "options": [
            {
              "value": "sodium_acetate",
              "label": "Sodium acetate"
            },
            {
              "value": "sodium_bromide",
              "label": "Sodium bromide"
            },
            {
              "value": "sodium_carbonate",
              "label": "Sodium carbonate"
            },
            {
              "value": "sodium_chloride",
              "label": "Sodium chloride"
            },
            {
              "value": "sodium_citrate_dihydrate",
              "label": "Sodium citrate dihydrate"
            },
            {
              "value": "sodium_dihydrogen_phosphate",
              "label": "Sodium dihydrogen phosphate"
            },
            {
              "value": "sodium_hydrogen_carbonate",
              "label": "Sodium hydrogen carbonate"
            },
            {
              "value": "sodium_hydrogen_phosphate",
              "label": "Sodium hydrogen phosphate"
            },
            {
              "value": "sodium_hydroxide",
              "label": "Sodium hydroxide"
            },
            {
              "value": "sodium_nitrate",
              "label": "Sodium nitrate"
            },
            {
              "value": "sodium_phosphate",
              "label": "Sodium phosphate"
            },
            {
              "value": "sodium_sulfate",
              "label": "Sodium sulfate"
            },
            {
              "value": "sodium_thiosulfate",
              "label": "Sodium thiosulfate"
            }
          ]
        },
        {
          "id": "concentration_unit",
          "label": "Concentration Unit",
          "type": "select",
          "options": [
            {
              "value": "wt_percent",
              "label": "Mass % (wt%)"
            },
            {
              "value": "mol_kg",
              "label": "mol/kg (Molality)"
            },
            {
              "value": "mol_liter",
              "label": "mol/liter (Molarity)"
            }
          ]
        },
        {
          "id": "concentration_value",
          "label": "Concentration",
          "type": "number",
          "defaultValue": 5,
          "unit": "varies"
        }
      ],
      "outputs": [
        {
          "id": "density_g_cm3",
          "label": "Density at 20°C",
          "unit": "g/cm³",
          "format": "decimal",
          "formula": "inputs.concentration_value"
        },
        {
          "id": "molality",
          "label": "Molality",
          "unit": "mol/kg water",
          "format": "decimal",
          "formula": "inputs.concentration_value"
        },
        {
          "id": "molarity",
          "label": "Molarity",
          "unit": "mol/liter",
          "format": "decimal",
          "formula": "inputs.concentration_value"
        }
      ]
    },

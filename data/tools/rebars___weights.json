{
  "id": "rebars___weights",
  "title": "Rebars - Weights",
  "description": "Weights of rebar rods - size ranging 1/4. Calculate total weight based on rod number and linear feet.",
  "type": "calculator-table",
  "components": [
    {
      "type": "markdown",
      "content": "# Rebars - Weights\n\nWeights of rebar rods - size ranging 1/4.\n\n**Conversion factors:**\n* 1 in = 25.4 mm\n* 1 lb/ft = 1.5 kg/m"
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "rodNumber",
          "label": "Rod Number",
          "type": "select",
          "options": [
            {
              "value": "2",
              "label": "2 (1/4\")"
            },
            {
              "value": "3",
              "label": "3 (3/8\")"
            },
            {
              "value": "4",
              "label": "4 (1/2\")"
            },
            {
              "value": "5",
              "label": "5 (5/8\")"
            },
            {
              "value": "6",
              "label": "6 (3/4\")"
            },
            {
              "value": "7",
              "label": "7 (7/8\")"
            },
            {
              "value": "8",
              "label": "8 (1\")"
            },
            {
              "value": "9",
              "label": "9 (1 1/8\")"
            },
            {
              "value": "10",
              "label": "10 (1 1/4\")"
            },
            {
              "value": "11",
              "label": "11 (1 3/8\")"
            },
            {
              "value": "14",
              "label": "14 (1 3/4\")"
            },
            {
              "value": "18",
              "label": "18 (2 1/4\")"
            }
          ]
        },
        {
          "id": "linearFeet",
          "label": "Length",
          "type": "number",
          "unit": "ft",
          "defaultValue": 100
        }
      ],
      "outputs": [
        {
          "id": "totalWeightLb",
          "label": "Total Weight",
          "unit": "lb",
          "format": "decimal",
          "formula": "inputs.linearFeet * (inputs.rodNumber === '2' ? 0.17 : inputs.rodNumber === '3' ? 0.38 : inputs.rodNumber === '4' ? 0.67 : inputs.rodNumber === '5' ? 1.04 : inputs.rodNumber === '6' ? 1.50 : inputs.rodNumber === '7' ? 2.04 : inputs.rodNumber === '8' ? 2.67 : inputs.rodNumber === '9' ? 3.40 : inputs.rodNumber === '10' ? 4.30 : inputs.rodNumber === '11' ? 5.31 : inputs.rodNumber === '14' ? 7.65 : inputs.rodNumber === '18' ? 13.60 : 0)"
        },
        {
          "id": "totalWeightKg",
          "label": "Total Weight",
          "unit": "kg",
          "format": "decimal",
          "formula": "inputs.linearFeet * (inputs.rodNumber === '2' ? 0.17 : inputs.rodNumber === '3' ? 0.38 : inputs.rodNumber === '4' ? 0.67 : inputs.rodNumber === '5' ? 1.04 : inputs.rodNumber === '6' ? 1.50 : inputs.rodNumber === '7' ? 2.04 : inputs.rodNumber === '8' ? 2.67 : inputs.rodNumber === '9' ? 3.40 : inputs.rodNumber === '10' ? 4.30 : inputs.rodNumber === '11' ? 5.31 : inputs.rodNumber === '14' ? 7.65 : inputs.rodNumber === '18' ? 13.60 : 0) * 1.5"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Rod Number",
        "Rod Size (in)",
        "Rod Weight (lb/ft)",
        "Rod Weight (kg/m)"
      ],

      "inputs": [
        {
          "id": "material",
          "label": "Wire Material",
          "type": "select",
          "options": [
            {
              "value": "copper",
              "label": "Copper"
            },
            {
              "value": "aluminum",
              "label": "Aluminum"
            }
          ],
          "defaultValue": "copper"
        },
        {
          "id": "length",
          "label": "Length",
          "type": "number",
          "unit": "m",
          "defaultValue": 100
        },
        {
          "id": "cross_section",
          "label": "Cross-Sectional Area",
          "type": "number",
          "unit": "mm²",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "resistivity",
          "label": "Resistivity",
          "unit": "Ω·mm²/m",
          "formula": "inputs.material === 'copper' ? 0.0172 : 0.0282",
          "format": "decimal"
        },
        {
          "id": "resistance",
          "label": "Resistance",
          "unit": "Ω",
          "formula": "(inputs.material === 'copper' ? 0.0172 : 0.0282) * inputs.length / inputs.cross_section",
          "format": "decimal"
        }
      ]
    }

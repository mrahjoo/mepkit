{
  "id": "polyester_polyolefin_ropes___strengths",
  "title": "Polyester Polyolefin Ropes - Strengths",
  "description": "Polyester Polyolefin dual fiber 3-strand rope - minimum breaking strength and safe load calculator with reference table.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "rope_strength_calculator",
      "content": "Calculate maximum safe mass for polyester polyolefin rope",
      "inputs": [
        {
          "id": "safe_load_kN",
          "label": "Safe Load",
          "type": "number",
          "unit": "kN",
          "defaultValue": 1
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity",
          "type": "number",
          "unit": "m/s²",
          "defaultValue": 9.81
        }
      ],
      "outputs": [
        {
          "id": "max_safe_mass",
          "label": "Maximum Safe Mass",
          "formula": "(inputs.safe_load_kN * 1000) / inputs.gravity",
          "unit": "kg",
          "format": "decimal"
        }
      ]
    },

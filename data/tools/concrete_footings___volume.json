{
  "id": "concrete_footings___volume",
  "title": "Concrete Footings - Volume",
  "description": "Estimate required concrete footing volume using the formula v = 0.0031 × l × w × t, where v is concrete volume in cubic yards, l is length in feet, w is width in feet, and t is depth in inches.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "length",
          "label": "Length of Footing",
          "type": "number",
          "unit": "ft",
          "defaultValue": 10
        },
        {
          "id": "width",
          "label": "Width of Footing",
          "type": "number",
          "unit": "ft",
          "defaultValue": 1
        },
        {
          "id": "depth",
          "label": "Depth of Footing",
          "type": "number",
          "unit": "in",
          "defaultValue": 12
        }
      ],
      "outputs": [
        {
          "id": "volume",
          "label": "Required Concrete Volume",
          "unit": "cy",
          "formula": "0.0031 * inputs.length * inputs.width * inputs.depth",
          "format": "decimal"
        }
      ]

{
  "id": "water_density__specific_weight_and__thermal_expans",
  "title": "Water Density, Specific Weight and Thermal Expansion Coefficients",
  "description": "Calculate water density, specific weight, and thermal expansion coefficients based on temperature and pressure. Pure water reaches maximum density of 1000 kg/m³ at 4°C. This calculator provides density values in multiple units (g/cm³, kg/m³, lb/ft³, lb/gal, sl/ft³) across temperature ranges 0-370°C and pressure conditions from atmospheric to 10,000 psi.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "water_density_calc",
      "content": "Calculate water density and properties at standard atmospheric pressure",
      "inputs": [
        {
          "id": "temperature_c",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "pressure_condition",
          "label": "Pressure Condition",
          "type": "select",
          "defaultValue": "atmospheric",
          "options": [
            {
              "label": "Atmospheric (0-100°C at 1 atm)",
              "value": "atmospheric"
            },
            {
              "label": "Saturation (>100°C)",
              "value": "saturation"
            },
            {
              "label": "1000 psi (68.1 atm)",
              "value": "1000psi"
            },
            {
              "label": "10000 psi (681 atm)",
              "value": "10000psi"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "density_g_cm3",
          "label": "Density",
          "unit": "g/cm³",
          "format": "decimal",
          "formula": "inputs.temperature_c < 100 ? (inputs.temperature_c === 4 ? 0.9999749 : inputs.temperature_c === 20 ? 0.9982067 : inputs.temperature_c === 0.1 ? 0.9998495 : 0.9997) : 0.95835"
        },
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "inputs.density_g_cm3 * 1000"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.06243"
        },
        {
          "id": "density_lb_gal",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.008345"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.00194032"
        },
        {
          "id": "specific_weight_kg_m2_s2",
          "label": "Specific Weight",
          "unit": "kg/(m² s²)",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 9.807"
        },
        {
          "id": "specific_weight_kn_m3",
          "label": "Specific Weight",
          "unit": "kN/m³",
          "format": "decimal",
          "formula": "inputs.specific_weight_kg_m2_s2 / 1000"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "inputs.density_lb_ft3 * 32.174"
        }
      ]
    },

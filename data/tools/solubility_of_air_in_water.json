{
  "id": "solubility_of_air_in_water",
  "title": "Solubility of Air in Water",
  "description": "Calculate the solubility of air dissolved in water based on temperature and pressure using Henry's Law. The amount of air that can be dissolved in water increases with pressure and decreases with temperature.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "air_solubility_calculator",
      "content": "Henry's Law Calculator - Air Solubility in Water",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 25,
          "unit": "°C"
        },
        {
          "id": "pressure",
          "label": "Absolute Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "atm"
        },
        {
          "id": "water_volume",
          "label": "Water Volume",
          "type": "number",
          "defaultValue": 1,
          "unit": "litre"
        }
      ],
      "outputs": [
        {
          "id": "dissolved_air_mass",
          "label": "Dissolved Air Mass",
          "formula": "inputs.pressure * inputs.water_volume * 0.0227",
          "unit": "g",
          "format": "decimal"
        },
        {
          "id": "dissolved_air_per_kg",
          "label": "Dissolved Air per Water Mass",
          "formula": "inputs.pressure * 0.023",
          "unit": "g/kg",
          "format": "decimal"
        },
        {
          "id": "oxygen_dissolved",
          "label": "Oxygen Dissolved (at 25°C)",
          "formula": "inputs.pressure * 0.0089 * inputs.water_volume",
          "unit": "g",
          "format": "decimal"
        },
        {
          "id": "nitrogen_dissolved",
          "label": "Nitrogen Dissolved (at 25°C)",
          "formula": "inputs.pressure * 0.0138 * inputs.water_volume",
          "unit": "g",
          "format": "decimal"
        }
      ]
    },

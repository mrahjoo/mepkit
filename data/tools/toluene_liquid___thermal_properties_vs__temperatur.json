          0.136,
          419,
          5.55
        ],
        [
          100,
          793,
          1.968,
          0.128,
          269,
          4.14
        ],
        [
          200,
          672,
          2.617,
          0.108,
          133,
          3.22
        ]
      ]
    },
    {
      "type": "markdown",
      "content": "## Unit Conversions\n\n- 1 kg/m³ = 0.0624 lb/ft³\n- 1 kJ/kgK = 0.2389 Btu/lbm°F\n- 1 W/(m K) = 6.935 (Btu in)/(ft² h °F)\n- 1 Pa s (N s/m²) = 10 P (Poise) = 10³ cP = 0.1020 kp s/m² = 0.6721 lb/(ft s)"
    }
  ]
}
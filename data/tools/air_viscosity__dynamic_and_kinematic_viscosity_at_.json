{
  "id": "air_viscosity__dynamic_and_kinematic_viscosity_at_",
  "title": "Air Viscosity: Dynamic and Kinematic Viscosity",
  "description": "Calculate air dynamic or kinematic viscosity at given temperatures and atmospheric pressure. Temperature must be within -100 to 1600 °C, -150 to 2900 °F, 175 to 1900 K, or 310 to 3400 °R for valid values. Outputs are provided in multiple units including Pa·s, cP, mPa·s, lb·f·s/ft², cSt, m²/s, and ft²/s.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "options": [
            {
              "value": "C",
              "label": "°C"
            },
            {
              "value": "F",
              "label": "°F"
            },
            {
              "value": "K",
              "label": "K"
            },
            {
              "value": "R",
              "label": "°R"
            }
          ],
          "defaultValue": "C"
        }
      ],
      "outputs": [
        {
          "id": "dynamic_viscosity_pas",
          "label": "Dynamic Viscosity (Pa·s)",
          "formula": "inputs.temperature * 0.00001 + 0.018",
          "unit": "Pa·s",
          "format": "decimal"
        },
        {
          "id": "dynamic_viscosity_cp",
          "label": "Dynamic Viscosity (cP)",
          "formula": "(inputs.temperature * 0.00001 + 0.018) * 1000",
          "unit": "cP",
          "format": "decimal"
        },
        {
          "id": "dynamic_viscosity_mpas",
          "label": "Dynamic Viscosity (mPa·s)",
          "formula": "(inputs.temperature * 0.00001 + 0.018) * 1000",
          "unit": "mPa·s",
          "format": "decimal"
        },
        {
          "id": "kinematic_viscosity_cst",
          "label": "Kinematic Viscosity (cSt)",
          "formula": "inputs.temperature * 0.00015 + 0.013",
          "unit": "cSt",
          "format": "decimal"
        },
        {
          "id": "kinematic_viscosity_m2s",
          "label": "Kinematic Viscosity (m²/s)",
          "formula": "(inputs.temperature * 0.00015 + 0.013) * 0.000001",
          "unit": "m²/s",
          "format": "scientific"
        },
        {
          "id": "kinematic_viscosity_ft2s",
          "label": "Kinematic Viscosity (ft²/s)",
          "formula": "(inputs.temperature * 0.00015 + 0.013) * 0.0000107639",
          "unit": "ft²/s",
          "format": "scientific"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Temperature (°C)",
        "Dynamic Viscosity (μPa·s)",

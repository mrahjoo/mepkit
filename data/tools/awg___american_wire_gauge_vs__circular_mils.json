{
  "id": "awg___american_wire_gauge_vs__circular_mils",
  "title": "AWG - American Wire Gauge vs. Circular Mils",
  "description": "Calculate wire diameter and cross-sectional area from American Wire Gauge (AWG) number. Convert between AWG, diameter (inches and mm), and area (circular mils and mm²).",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "gauge",
          "label": "AWG Gauge Number",
          "type": "number",
          "defaultValue": 12,
          "unit": "AWG"
        }
      ],
      "outputs": [
        {
          "id": "diameter_inches",
          "label": "Diameter",
          "formula": "0.00592 * Math.pow(36 - inputs.gauge, 1/39)",
          "unit": "inches",
          "format": "decimal"
        },
        {
          "id": "diameter_mm",
          "label": "Diameter",
          "formula": "0.12792 * Math.pow(36 - inputs.gauge, 1/39)",
          "unit": "mm",
          "format": "decimal"
        },
        {
          "id": "area_circular_mils",
          "label": "Area",
          "formula": "Math.pow(0.00592 * Math.pow(36 - inputs.gauge, 1/39) * 1000, 2)",
          "unit": "circular mils",
          "format": "decimal"
        },
        {
          "id": "area_mm2",
          "label": "Area",
          "formula": "Math.PI * Math.pow(0.12792 * Math.pow(36 - inputs.gauge, 1/39) / 2, 2)",
          "unit": "mm²",
          "format": "decimal"
        }
      ]
    },
    {

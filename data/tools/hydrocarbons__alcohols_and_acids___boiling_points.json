            {
              "label": "Alkanoic Acid",
              "value": "alkanoic_acid"
            }
          ]
        },
        {
          "id": "carbon_number",
          "label": "Carbon Number",
          "type": "number",
          "defaultValue": 1,
          "unit": "C"
        }
      ],
      "outputs": [
        {
          "id": "boiling_point_celsius",
          "label": "Boiling Point",
          "unit": "°C",
          "format": "decimal",
          "formula": "Lookup from compound type and carbon number database"
        },
        {
          "id": "boiling_point_fahrenheit",
          "label": "Boiling Point",
          "unit": "°F",
          "format": "decimal",
          "formula": "inputs.boiling_point_celsius * 9/5 + 32"
        }
      ]

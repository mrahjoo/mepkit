{
  "id": "angular_motion___power_and_torque",
  "title": "Angular Motion - Power and Torque",
  "description": "Calculate power, torque, and angular motion parameters. Includes formulas for rotating bodies with options to work in SI units (watts, Nm, rpm) or imperial units (hp, ft lbf, rpm).",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "power_torque_calculator",
      "content": "Power and Torque Calculator",
      "inputs": [
        {
          "id": "power_w",
          "label": "Power",
          "type": "number",
          "unit": "W",
          "defaultValue": 2000
        },
        {
          "id": "rpm",
          "label": "Rotations per Minute",
          "type": "number",
          "unit": "rpm",
          "defaultValue": 3600
        },
        {
          "id": "unit_system",
          "label": "Unit System",
          "type": "select",
          "options": [
            {
              "label": "SI (Watts, Nm)",
              "value": "si"
            },
            {
              "label": "Imperial (HP, ft lbf)",
              "value": "imperial"
            }
          ],
          "defaultValue": "si"
        }
      ],
      "outputs": [
        {
          "id": "torque_nm",
          "label": "Torque",
          "formula": "inputs.unit_system === 'si' ? (30 * inputs.power_w) / (3.14159 * inputs.rpm) : (inputs.power_w * 5252) / inputs.rpm",
          "unit": "Nm / ft lbf",
          "format": "decimal"
        },
        {
          "id": "angular_velocity",
          "label": "Angular Velocity",
          "formula": "(2 * 3.14159 * inputs.rpm) / 60",
          "unit": "rad/s",
          "format": "decimal"
        }
      ]
    },

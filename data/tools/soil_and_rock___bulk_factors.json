      ]
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "borrow_volume",
          "label": "Borrow Volume",
          "type": "number",
          "unit": "m³",
          "defaultValue": 300
        },
        {
          "id": "bulking_factor",
          "label": "Bulking (Swell) Factor",
          "type": "number",
          "unit": "%",
          "defaultValue": 40
        }
      ],
      "outputs": [
        {
          "id": "dump_volume",
          "label": "Dump Volume",
          "unit": "m³",
          "formula": "inputs.borrow_volume * (100 + inputs.bulking_factor) / 100",
          "format": "decimal"
        }
      ],
      "content": "### Example - Swell Factor\n\nAfter excavation of borrow material with a bulking factor - the material swells in the dump.\n\nFormula: _(Borrow Volume m³) × (100% + Bulking Factor %) / 100%_"
    }
  ]

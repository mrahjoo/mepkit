{
  "id": "darcy_weisbach_equation__flow_resistance___pressur",
  "title": "Darcy-Weisbach Equation: Flow Resistance & Pressure Loss Calculator",
  "description": "Calculate pressure loss and head loss in pipes, tubes, and ducts using the Darcy-Weisbach equation. Supports both velocity-based and volume flow calculations with SI and Imperial units.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "pressure_loss_calculator",
      "content": "Pressure Loss Calculator (Darcy-Weisbach Equation)",
      "inputs": [
        {
          "id": "friction_coefficient",
          "label": "Friction Coefficient (λ)",
          "type": "number",
          "defaultValue": 0.019,
          "unit": ""
        },
        {
          "id": "duct_length",
          "label": "Duct/Pipe Length (l)",
          "type": "number",
          "defaultValue": 1,
          "unit": "m"
        },
        {
          "id": "hydraulic_diameter",
          "label": "Hydraulic Diameter (dh)",
          "type": "number",
          "defaultValue": 0.315,
          "unit": "m"
        },
        {
          "id": "fluid_density",
          "label": "Fluid Density (ρf)",
          "type": "number",
          "defaultValue": 1.2,
          "unit": "kg/m³"
        },
        {
          "id": "fluid_velocity",
          "label": "Fluid Velocity (v)",
          "type": "number",
          "defaultValue": 6,
          "unit": "m/s"
        }
      ],
      "outputs": [
        {
          "id": "pressure_loss_pa",
          "label": "Pressure Loss",
          "formula": "inputs.friction_coefficient * (inputs.duct_length / inputs.hydraulic_diameter) * (inputs.fluid_density * inputs.fluid_velocity * inputs.fluid_velocity / 2)",
          "unit": "Pa",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "calculator",
      "id": "head_loss_calculator",
      "content": "Head Loss Calculator (Darcy-Weisbach Equation)",
      "inputs": [
        {
          "id": "friction_coeff_head",
          "label": "Friction Coefficient (λ)",
          "type": "number",
          "defaultValue": 0.019,
          "unit": ""
        },
        {
          "id": "pipe_length_head",
          "label": "Pipe/Duct Length (l)",
          "type": "number",
          "defaultValue": 1,
          "unit": "m"
        },
        {
          "id": "hydraulic_diam_head",
          "label": "Hydraulic Diameter (dh)",
          "type": "number",
          "defaultValue": 0.315,
          "unit": "m"
        },
        {
          "id": "flow_fluid_density",
          "label": "Flowing Fluid Density (ρf)",
          "type": "number",
          "defaultValue": 1.2,
          "unit": "kg/m³"
        },
        {
          "id": "reference_fluid_density",
          "label": "Reference Fluid Density (ρw)",
          "type": "number",
          "defaultValue": 1000,
          "unit": "kg/m³"
        },
        {
          "id": "flow_velocity_head",
          "label": "Flow Velocity (v)",
          "type": "number",
          "defaultValue": 6,
          "unit": "m/s"
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity (g)",
          "type": "number",
          "defaultValue": 9.81,
          "unit": "m/s²"
        }
      ],
      "outputs": [
        {
          "id": "head_loss_m",
          "label": "Head Loss (Water Column)",
          "formula": "inputs.friction_coeff_head * (inputs.pipe_length_head / inputs.hydraulic_diam_head) * (inputs.flow_fluid_density / inputs.reference_fluid_density) * (inputs.flow_velocity_head * inputs.flow_velocity_head / (2 * inputs.gravity))",
          "unit": "m H₂O",
          "format": "decimal"
        },
        {
          "id": "head_loss_mm",
          "label": "Head Loss (mm H₂O)",
          "formula": "inputs.friction_coeff_head * (inputs.pipe_length_head / inputs.hydraulic_diam_head) * (inputs.flow_fluid_density / inputs.reference_fluid_density) * (inputs.flow_velocity_head * inputs.flow_velocity_head / (2 * inputs.gravity)) / 1000",
          "unit": "mm H₂O",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "reference_values_table",
      "content": "Reference Values & Constants",
      "headers": [

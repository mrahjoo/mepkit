{
  "id": "sound_transmission_through_massive_walls_or_floors",
  "title": "Sound Transmission through Massive Walls or Floors",
  "description": "Calculate sound attenuation through massive walls or floors based on material mass and frequency. The attenuation depends primarily on the mass of the construction, with higher mass providing greater sound insulation.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "mass_calculator",
      "content": "Calculate the mass per unit area of a construction element",
      "inputs": [
        {
          "id": "density",
          "label": "Material Density",
          "type": "number",
          "unit": "kg/m³",
          "defaultValue": 2300
        },
        {
          "id": "thickness",
          "label": "Thickness",
          "type": "number",
          "unit": "m",
          "defaultValue": 0.2
        }
      ],
      "outputs": [
        {
          "id": "mass_per_area",
          "label": "Mass per Unit Area",
          "formula": "inputs.density * inputs.thickness",
          "unit": "kg/m²",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "calculator",
      "id": "attenuation_calculator",
      "content": "Calculate sound attenuation at specific frequencies",
      "inputs": [
        {
          "id": "mean_attenuation",
          "label": "Mean Sound Attenuation",
          "type": "number",
          "unit": "dB",
          "defaultValue": 52
        },
        {
          "id": "frequency",
          "label": "Frequency",
          "type": "select",
          "options": [
            {
              "value": -13,
              "label": "63 Hz (-13 dB)"
            },
            {
              "value": -9,
              "label": "125 Hz (-9 dB)"
            },
            {
              "value": -5,
              "label": "250 Hz (-5 dB)"
            },
            {
              "value": -1,
              "label": "500 Hz (-1 dB)"
            },
            {
              "value": 3,
              "label": "1000 Hz (3 dB)"
            },
            {
              "value": 7,
              "label": "2000 Hz (7 dB)"
            },
            {
              "value": 11,
              "label": "4000 Hz (11 dB)"
            },
            {
              "value": 15,
              "label": "8000 Hz (15 dB)"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "frequency_attenuation",
          "label": "Sound Attenuation at Frequency",
          "formula": "inputs.mean_attenuation + inputs.frequency",
          "unit": "dB",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",

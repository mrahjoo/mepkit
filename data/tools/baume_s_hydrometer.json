{
  "id": "baume_s_hydrometer",
  "title": "Baume's Hydrometer",
  "description": "Liquid density with Degree Baume vs. Specific Gravity. Measure the density of a liquid using the Baumé scale with conversion to specific gravity. Reference temperature: 60°F (16°C).",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "baume_calculator",
      "content": "Convert between Degree Baume and Specific Gravity",
      "headers": [
        "Density Measurement"
      ],
      "inputs": [
        {
          "id": "baume_degree",
          "label": "Degree Baumé",
          "type": "number",
          "defaultValue": 10,
          "unit": "°Bé"
        },
        {
          "id": "scale_type",
          "label": "Scale Type",
          "type": "select",
          "options": [
            {
              "value": "heavier",
              "label": "Heavier than Water"
            },
            {
              "value": "lighter",
              "label": "Lighter than Water"
            }
          ],
          "defaultValue": "heavier"
        }
      ],
      "outputs": [
        {
          "id": "specific_gravity",
          "label": "Specific Gravity",
          "formula": "IF(inputs.scale_type='heavier', 1.0 + (inputs.baume_degree * 0.0074), 1.0 - (inputs.baume_degree * 0.0074))",
          "unit": "SG",
          "format": "decimal"
        }
      ]
    },
    {

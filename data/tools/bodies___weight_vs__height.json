{
  "id": "bodies___weight_vs__height",
  "title": "Bodies - Weight vs. Height",
  "description": "Typical ideal body weight versus height. Reference tables for men and women showing ideal body weight ranges by frame size across different heights.",
  "type": "calculator",
  "components": [
    {
      "type": "markdown",
      "content": "## Ideal Body Weight vs. Height\n\nThis tool provides typical ideal body weight ranges based on height and frame size for both men and women.\n\n### How to Use\n1. Select your gender\n2. Enter your height (feet and inches)\n3. View your recommended weight range based on your frame size"
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "gender",
          "label": "Gender",
          "type": "select",
          "options": [
            {
              "label": "Male",
              "value": "male"
            },
            {
              "label": "Female",
              "value": "female"
            }
          ],
          "defaultValue": "male"
        },
        {
          "id": "feet",
          "label": "Height (feet)",
          "type": "number",
          "defaultValue": 5,
          "unit": "ft"
        },
        {
          "id": "inches",
          "label": "Height (inches)",
          "type": "number",
          "defaultValue": 10,
          "unit": "in"
        }
      ],
      "outputs": [
        {
          "id": "height_cm",
          "label": "Height (cm)",
          "unit": "cm",
          "format": "decimal",
          "formula": "Math.round((inputs.feet * 12 + inputs.inches) * 2.54)"
        },
        {
          "id": "small_frame_min",
          "label": "Small Frame Min",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.0 - 130) : Math.round((inputs.feet * 12 + inputs.inches) * 3.5 - 108)"
        },
        {
          "id": "small_frame_max",
          "label": "Small Frame Max",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.1 - 135) : Math.round((inputs.feet * 12 + inputs.inches) * 3.6 - 115)"
        },
        {
          "id": "medium_frame_min",
          "label": "Medium Frame Min",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.2 - 140) : Math.round((inputs.feet * 12 + inputs.inches) * 3.7 - 120)"
        },
        {
          "id": "medium_frame_max",
          "label": "Medium Frame Max",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.3 - 150) : Math.round((inputs.feet * 12 + inputs.inches) * 3.8 - 127)"
        },
        {
          "id": "large_frame_min",
          "label": "Large Frame Min",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.4 - 160) : Math.round((inputs.feet * 12 + inputs.inches) * 3.9 - 132)"
        },
        {
          "id": "large_frame_max",
          "label": "Large Frame Max",
          "unit": "lbs",
          "format": "decimal",
          "formula": "inputs.gender === 'male' ? Math.round((inputs.feet * 12 + inputs.inches) * 4.6 - 180) : Math.round((inputs.feet * 12 + inputs.inches) * 4.1 - 145)"
        }
      ]
    },

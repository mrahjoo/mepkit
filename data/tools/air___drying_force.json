{
  "id": "air___drying_force",
  "title": "Air - Drying Force",
  "description": "Calculate the drying force of air, which is the difference between saturation vapor pressure and actual vapor pressure. The drying force represents the vapor carrying capacity of humid air and is essential for understanding drying processes.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "drying_force_calculator",
      "content": "Calculate drying force based on saturation pressure and actual vapor pressure",
      "inputs": [
        {
          "id": "saturation_pressure",
          "label": "Saturation Vapor Pressure",
          "type": "number",
          "unit": "mbar",
          "defaultValue": 25
        },
        {
          "id": "vapor_pressure",
          "label": "Actual Vapor Pressure",
          "type": "number",
          "unit": "mbar",
          "defaultValue": 12.5
        }
      ],
      "outputs": [
        {
          "id": "drying_force",
          "label": "Drying Force",
          "formula": "inputs.saturation_pressure - inputs.vapor_pressure",
          "unit": "mbar",
          "format": "decimal"
        }
      ]
    },
    {

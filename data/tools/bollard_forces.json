{
  "id": "bollard_forces",
  "title": "Bollard Forces",
  "description": "Calculate the effort force required to hold a load force in a rope wrapped around a bollard or pole. The effort force is dramatically reduced by wrapping the rope around the bollard due to friction.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "bollard_calculator",
      "content": "Bollard Effort Force Calculator",
      "inputs": [
        {
          "id": "load_force",
          "label": "Load Force",
          "type": "number",
          "unit": "N",
          "defaultValue": 500
        },
        {
          "id": "friction_coefficient",
          "label": "Friction Coefficient",
          "type": "number",
          "defaultValue": 0.4
        },
        {
          "id": "angle_degrees",
          "label": "Angle (degrees)",
          "type": "number",
          "unit": "°",
          "defaultValue": 180
        }
      ],
      "outputs": [
        {
          "id": "effort_force",
          "label": "Effort Force",
          "unit": "N",
          "formula": "inputs.load_force * Math.exp(-(inputs.friction_coefficient * inputs.angle_degrees * Math.PI / 180))",
          "format": "decimal"
        },
        {
          "id": "force_ratio",
          "label": "Effort/Load Ratio",
          "formula": "Math.exp(-(inputs.friction_coefficient * inputs.angle_degrees * Math.PI / 180))",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "chart",
      "id": "bollard_chart",
      "content": "Effort Force vs Rope Angle",
      "headers": [
        "Angle (degrees)",
        "Friction 0.3",

{
  "id": "methane___thermal_conductivity_vs__temperature_and",
  "title": "Methane - Thermal Conductivity vs. Temperature and Pressure",
  "description": "Calculator for estimating the thermal conductivity of gaseous methane at given temperatures and pressures. Thermal conductivity is a material property describing the ability to conduct heat. This tool provides output in multiple units: mW/(m K), Btu(IT)/(h ft °F), (Btu(IT) in)/(h ft² °F) and kcal(IT)/(h m K).",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "methane_thermal_conductivity_calc",
      "content": "Methane Thermal Conductivity Calculator at 1 bara",
      "inputs": [
        {
          "id": "temperature_kelvin",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 300,
          "unit": "K"
        },
        {
          "id": "pressure_bara",
          "label": "Pressure",
          "type": "select",
          "defaultValue": 1,
          "options": [
            {
              "value": 0.1,
              "label": "0.1 bara"
            },
            {
              "value": 1,
              "label": "1 bara"
            },
            {
              "value": 5,
              "label": "5 bara"
            },
            {
              "value": 10,
              "label": "10 bara"
            },
            {
              "value": 100,
              "label": "100 bara"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "thermal_conductivity_mw_mk",
          "label": "Thermal Conductivity",
          "unit": "mW/(m K)",
          "formula": "inputs.temperature_kelvin * 0.1 + 10",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity_btu",
          "label": "Thermal Conductivity",
          "unit": "Btu(IT)/(h ft °F)",
          "formula": "(inputs.temperature_kelvin * 0.1 + 10) * 0.0005779",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity_btu_in",
          "label": "Thermal Conductivity",
          "unit": "(Btu(IT) in)/(h ft² °F)",
          "formula": "(inputs.temperature_kelvin * 0.1 + 10) * 0.0069335",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity_kcal",
          "label": "Thermal Conductivity",
          "unit": "kcal(IT)/(h m K)",
          "formula": "(inputs.temperature_kelvin * 0.1 + 10) * 0.0085984",
          "format": "decimal"
        }
      ]
    },

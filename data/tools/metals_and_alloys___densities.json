      "type": "calculator",
      "id": "density_converter",
      "content": "## Density Unit Converter",
      "inputs": [
        {
          "id": "density_kgm3",
          "label": "Density",
          "type": "number",
          "unit": "kg/m³",
          "defaultValue": 7850
        }
      ],
      "outputs": [
        {
          "id": "density_lbft3",
          "label": "Density",
          "unit": "lb/ft³",
          "formula": "inputs.density_kgm3 * 0.0624",
          "format": "decimal"
        },
        {
          "id": "density_lbin3",
          "label": "Density",
          "unit": "lb/in³",
          "formula": "inputs.density_kgm3 * 0.000036127",

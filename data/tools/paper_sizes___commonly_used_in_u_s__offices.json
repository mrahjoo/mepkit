    {
      "type": "calculator",
      "inputs": [
        {
          "id": "paper_width_inches",
          "label": "Paper Width",
          "type": "number",
          "defaultValue": 8.5,
          "unit": "inches"
        },
        {
          "id": "paper_height_inches",
          "label": "Paper Height",
          "type": "number",
          "defaultValue": 11,
          "unit": "inches"
        }
      ],
      "outputs": [
        {
          "id": "width_mm",
          "label": "Width (mm)",
          "formula": "inputs.paper_width_inches * 25.4",
          "format": "decimal",
          "unit": "mm"
        },
        {
          "id": "height_mm",
          "label": "Height (mm)",
          "formula": "inputs.paper_height_inches * 25.4",
          "format": "decimal",
          "unit": "mm"
        },
        {
          "id": "area_sq_inches",
          "label": "Area",
          "formula": "inputs.paper_width_inches * inputs.paper_height_inches",
          "format": "decimal",
          "unit": "sq. inches"
        },
        {
          "id": "area_sq_mm",
          "label": "Area",
          "formula": "(inputs.paper_width_inches * 25.4) * (inputs.paper_height_inches * 25.4)",
          "format": "decimal",
          "unit": "sq. mm"
        }
      ]
    },

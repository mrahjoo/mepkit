    {
      "type": "calculator",
      "content": "# NPSH Calculations",
      "inputs": [
        {
          "id": "static_pressure",
          "label": "Static Pressure at Impeller (ps)",
          "type": "number",
          "unit": "Pa",
          "defaultValue": 101325
        },
        {
          "id": "fluid_velocity",
          "label": "Fluid Velocity (vs)",
          "type": "number",
          "unit": "m/s",
          "defaultValue": 2
        },
        {
          "id": "vapor_pressure",
          "label": "Vapor Pressure (pv)",
          "type": "number",
          "unit": "Pa",
          "defaultValue": 2300
        },
        {
          "id": "liquid_specific_weight",
          "label": "Liquid Specific Weight (γ)",
          "type": "number",
          "unit": "N/m³",
          "defaultValue": 9810
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity (g)",
          "type": "number",
          "unit": "m/s²",
          "defaultValue": 9.81
        },
        {
          "id": "elevation",
          "label": "Elevation (he) - Positive if above tank",
          "type": "number",
          "unit": "m",
          "defaultValue": 0.5
        },
        {
          "id": "head_loss",
          "label": "Head Loss in Suction Pipe (hl)",
          "type": "number",
          "unit": "m",
          "defaultValue": 0.5
        },
        {
          "id": "atmospheric_pressure",
          "label": "Atmospheric Pressure (patm)",
          "type": "number",
          "unit": "Pa",
          "defaultValue": 101325
        }
      ],
      "outputs": [
        {
          "id": "suction_head",
          "label": "Suction Head (hs)",
          "formula": "inputs.static_pressure / inputs.liquid_specific_weight + inputs.fluid_velocity * inputs.fluid_velocity / (2 * inputs.gravity)",
          "unit": "m",
          "format": "decimal"
        },
        {
          "id": "vapor_head",
          "label": "Vapor Head (hv)",
          "formula": "inputs.vapor_pressure / inputs.liquid_specific_weight",
          "unit": "m",
          "format": "decimal"
        },
        {
          "id": "npsh",
          "label": "Net Positive Suction Head (NPSH)",
          "formula": "inputs.static_pressure / inputs.liquid_specific_weight + inputs.fluid_velocity * inputs.fluid_velocity / (2 * inputs.gravity) - inputs.vapor_pressure / inputs.liquid_specific_weight",
          "unit": "m",
          "format": "decimal"
        },
        {
          "id": "npsha",
          "label": "Available NPSH (NPSHa)",
          "formula": "inputs.atmospheric_pressure / inputs.liquid_specific_weight - inputs.elevation - inputs.head_loss - inputs.vapor_pressure / inputs.liquid_specific_weight",
          "unit": "m",
          "format": "decimal"
        }
      ]
    }

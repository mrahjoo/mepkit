{
  "id": "ice___thermal_properties",
  "title": "Ice - Thermal Properties",
  "description": "Thermal and thermodynamic properties of ice like density, thermal conductivity and specific heat at temperatures from 0 to -100 °C",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "content": "Ice Thermal Properties Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 0,
          "unit": "°C"
        }
      ],
      "outputs": [
        {
          "id": "density",
          "label": "Density",
          "formula": "920.0 - (inputs.temperature * -0.009)",
          "unit": "kg/m³",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity",
          "label": "Thermal Conductivity",
          "formula": "2.22 + (inputs.temperature * -0.0078)",
          "unit": "W/mK",
          "format": "decimal"
        },
        {
          "id": "specific_heat",
          "label": "Specific Heat",
          "formula": "2.050 + (inputs.temperature * -0.0065)",
          "unit": "kJ/kgK",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",

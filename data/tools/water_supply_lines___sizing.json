{
  "id": "water_supply_lines___sizing",
  "title": "Water Supply Lines - Sizing",
  "description": "Sizing water supply service and distribution lines based on Water Supply Fixture Units (WSFU). Select supply pressure range and pipe configuration to determine maximum WSFU capacity for various pipe lengths.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "wsfu_calculator",
      "content": "Water Supply Fixture Units (WSFU) Sizing Calculator",
      "inputs": [
        {
          "id": "pressure_range",
          "label": "Supply Pressure Range",
          "type": "select",
          "options": [
            {
              "label": "30 - 45 psi",
              "value": "30-45"
            },
            {
              "label": "45 - 60 psi",
              "value": "45-60"
            },
            {
              "label": "Over 60 psi",
              "value": ">60"
            }
          ],
          "defaultValue": "30-45"
        },
        {
          "id": "meter_service_line",
          "label": "Meter and Street Service Line Size (inches)",
          "type": "select",
          "options": [
            {
              "label": "3/4\"",
              "value": 0.75
            },
            {
              "label": "1\"",
              "value": 1
            },
            {
              "label": "1 1/4\"",
              "value": 1.25
            }
          ],
          "defaultValue": 0.75
        },
        {
          "id": "building_supply_line",
          "label": "Building Supply and Branch Line Size (inches)",
          "type": "select",
          "options": [
            {
              "label": "1/2\"",
              "value": 0.5
            },
            {
              "label": "3/4\"",
              "value": 0.75
            },
            {
              "label": "1\"",
              "value": 1
            },
            {
              "label": "1 1/4\"",
              "value": 1.25
            }
          ],
          "defaultValue": 0.5
        },
        {
          "id": "pipe_length",
          "label": "Length of Pipe (feet)",
          "type": "select",
          "options": [
            {
              "label": "40 feet",
              "value": 40
            },
            {
              "label": "60 feet",
              "value": 60
            },
            {
              "label": "80 feet",
              "value": 80
            },
            {
              "label": "100 feet",
              "value": 100
            },
            {
              "label": "150 feet",
              "value": 150
            },
            {
              "label": "200 feet",
              "value": 200
            }
          ],
          "defaultValue": 40
        }
      ],
      "outputs": [
        {
          "id": "max_wsfu",
          "label": "Maximum Water Supply Fixture Units (WSFU)",
          "formula": "Based on selected pressure range, meter service line, building supply line, and pipe length from standard plumbing tables",
          "unit": "WSFU"
        },
        {
          "id": "pressure_info",
          "label": "Pressure Range",
          "formula": "inputs.pressure_range"
        }
      ]
    },
    {

{
  "id": "mercury___thermodynamic_properties",
  "title": "Mercury - Thermodynamic Properties",
  "description": "Properties of saturated liquid Mercury - Hg - density, specific heat capacity, kinematic viscosity, thermal conductivity and Prandtl number at various temperatures.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "mercury_properties_calculator",
      "content": "Mercury Thermodynamic Properties Calculator",
      "headers": [
        "Property",
        "Value"
      ],
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "unit": "°C",
          "defaultValue": 20
        }
      ],
      "outputs": [
        {
          "id": "density",
          "label": "Density (ρ)",
          "unit": "kg/m³",
          "formula": "13545 - 0.2 * (inputs.temperature - 20)",
          "format": "decimal"
        },
        {
          "id": "specific_heat",
          "label": "Specific Heat (cp)",
          "unit": "10³ J/kg·K",
          "formula": "0.139",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity",
          "label": "Thermal Conductivity (k)",
          "unit": "W/m·K",
          "formula": "8.69 + 0.0344 * (inputs.temperature - 20)",
          "format": "decimal"
        },
        {
          "id": "kinematic_viscosity",
          "label": "Kinematic Viscosity (ν)",
          "unit": "10⁻⁶ m²/s",
          "formula": "0.114 - 0.0005 * (inputs.temperature - 20)",
          "format": "decimal"
        },
        {
          "id": "prandtl_number",
          "label": "Prandtl Number (Pr)",
          "unit": "-",
          "formula": "0.025 - 0.00006 * (inputs.temperature - 20)",
          "format": "decimal"
        }
      ]
    },

{
  "id": "engineering_materials___properties",
  "title": "Engineering Materials - Properties",
  "description": "Comprehensive reference for typical properties of engineering materials including steel, plastics, ceramics, and composites. Compare density, tensile modulus, tensile strength, specific modulus, specific strength, and maximum service temperature across different material categories.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "material_properties_calc",
      "content": "Calculate material properties and derive specific characteristics",
      "inputs": [
        {
          "id": "density",
          "label": "Density (ρ)",
          "type": "number",
          "unit": "10³ kg/m³",
          "defaultValue": 2.7
        },
        {
          "id": "tensile_modulus",
          "label": "Tensile Modulus (E)",
          "type": "number",
          "unit": "GPa",
          "defaultValue": 73
        },
        {
          "id": "tensile_strength",
          "label": "Tensile Strength (σ)",
          "type": "number",
          "unit": "MPa",
          "defaultValue": 450
        }
      ],
      "outputs": [
        {
          "id": "specific_modulus",
          "label": "Specific Modulus (E/ρ)",
          "formula": "inputs.tensile_modulus / inputs.density",
          "unit": "GPa / (10³ kg/m³)"
        },
        {
          "id": "specific_strength",
          "label": "Specific Strength (σ/ρ)",
          "formula": "inputs.tensile_strength / (inputs.density * 1000)",
          "unit": "MPa / (10³ kg/m³)"
        }
      ]
    },
    {

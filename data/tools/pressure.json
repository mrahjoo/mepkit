{
  "id": "pressure",
  "title": "Pressure",
  "description": "Calculate pressure from force and area, or convert between different pressure units. Pressure is defined as the normal force per unit area exerted on a surface in a fluid or gas.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "pressure_calculator",
      "content": "## Pressure Calculator\n\nCalculate pressure from force and area using the equation: p = F / A",
      "inputs": [
        {
          "id": "force",
          "label": "Force",
          "type": "number",
          "unit": "N",
          "defaultValue": 1000
        },
        {
          "id": "area",
          "label": "Area",
          "type": "number",
          "unit": "m²",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "pressure_pa",
          "label": "Pressure",
          "unit": "Pa",
          "format": "decimal",
          "formula": "inputs.force / inputs.area"
        },
        {
          "id": "pressure_bar",
          "label": "Pressure",
          "unit": "bar",
          "format": "decimal",
          "formula": "(inputs.force / inputs.area) / 100000"
        },
        {
          "id": "pressure_psi",
          "label": "Pressure",
          "unit": "psi",
          "format": "decimal",
          "formula": "(inputs.force / inputs.area) / 6894.76"
        },
        {
          "id": "pressure_kpa",
          "label": "Pressure",
          "unit": "kPa",
          "format": "decimal",
          "formula": "(inputs.force / inputs.area) / 1000"
        }
      ]
    },
    {

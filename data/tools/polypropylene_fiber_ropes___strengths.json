        },
        {
          "id": "safe_load_lbf",
          "label": "Safe Load (Safety Factor 12)",
          "unit": "lbf",
          "format": "decimal",
          "formula": "inputs.min_breaking_strength_lbf / inputs.safety_factor"
        },
        {
          "id": "safe_load_kn",
          "label": "Safe Load",
          "unit": "kN",
          "format": "decimal",
          "formula": "IF(inputs.rope_diameter=0.25,0.417,IF(inputs.rope_diameter=0.3125,0.634,IF(inputs.rope_diameter=0.375,0.90,IF(inputs.rope_diameter=0.4375,1.17,IF(inputs.rope_diameter=0.5,1.40,IF(inputs.rope_diameter=0.5625,1.70,IF(inputs.rope_diameter=0.625,2.07,IF(inputs.rope_diameter=0.75,2.84,IF(inputs.rope_diameter=0.875,3.84,IF(inputs.rope_diameter=1.0,4.76,IF(inputs.rope_diameter=1.0625,5.34,IF(inputs.rope_diameter=1.125,5.92,IF(inputs.rope_diameter=1.25,7.16,IF(inputs.rope_diameter=1.375,7.83,IF(inputs.rope_diameter=1.5,10.1,IF(inputs.rope_diameter=1.625,11.8,IF(inputs.rope_diameter=1.75,13.7,IF(inputs.rope_diameter=2.0,17.3,0))))))))))))))))))))"
        },
        {
          "id": "max_safe_mass_kg",
          "label": "Maximum Safe Mass",
          "unit": "kg",
          "format": "decimal",
          "formula": "(inputs.safe_load_kn * 1000) / 9.81"
        },
        {
          "id": "weight_per_length_kg_m",
          "label": "Weight per Length",
          "unit": "kg/m",
          "format": "decimal",
          "formula": "IF(inputs.rope_diameter=0.25,0.02,IF(inputs.rope_diameter=0.3125,0.03,IF(inputs.rope_diameter=0.375,0.04,IF(inputs.rope_diameter=0.4375,0.05,IF(inputs.rope_diameter=0.5,0.07,IF(inputs.rope_diameter=0.5625,0.09,IF(inputs.rope_diameter=0.625,0.11,IF(inputs.rope_diameter=0.75,0.15,IF(inputs.rope_diameter=0.875,0.21,IF(inputs.rope_diameter=1.0,0.27,IF(inputs.rope_diameter=1.0625,0.30,IF(inputs.rope_diameter=1.125,0.34,IF(inputs.rope_diameter=1.25,0.41,IF(inputs.rope_diameter=1.375,0.45,IF(inputs.rope_diameter=1.5,0.59,IF(inputs.rope_diameter=1.625,0.68,IF(inputs.rope_diameter=1.75,0.79,IF(inputs.rope_diameter=2.0,1.03,0))))))))))))))))))))"
        }
      ]
    },

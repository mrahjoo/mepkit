            },
            {
              "value": "1.25",
              "label": "1 1/4 inch"
            },
            {
              "value": "1.375",
              "label": "1 3/8 inch"
            },
            {
              "value": "1.5",
              "label": "1 1/2 inch"
            },
            {
              "value": "1.625",
              "label": "1 5/8 inch"
            },
            {
              "value": "1.75",
              "label": "1 3/4 inch"
            },
            {
              "value": "2.0",
              "label": "2 inch"
            }
          ],
          "defaultValue": "0.375"
        },
        {
          "id": "safety_factor",
          "label": "Safety Factor",
          "type": "number",
          "defaultValue": 12,
          "unit": ""
        }
      ],
      "outputs": [
        {
          "id": "min_breaking_strength_lbf",
          "label": "Minimum Breaking Strength",
          "unit": "lbf",

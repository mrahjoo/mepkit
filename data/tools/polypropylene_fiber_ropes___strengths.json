{
  "id": "polypropylene_fiber_ropes___strengths",
  "title": "Polypropylene Fiber Ropes - Strengths",
  "description": "Polypropylene fiber 3-strand and 8 strand rope - minimum breaking strength and safe load calculator. Calculate safe loads and masses for various rope diameters.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "rope_strength_calc",
      "content": "Calculate polypropylene rope strength properties based on rope diameter",

{
  "id": "moist_air___psychrometric_table_for_pressure_29_92",
  "title": "Moist Air - Psychrometric Table for Pressure 29.92 inHg",
  "description": "Dry and wet bulb temperatures, saturation pressure, water vapor weight, specific volume, heat and more for moist air at standard pressure of 29.92 inHg.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "psychrometric_calculator",
      "content": "Calculate moist air properties for pressure 29.92 inHg",
      "inputs": [
        {
          "id": "dry_bulb_temp",
          "label": "Dry Bulb Temperature",
          "type": "number",
          "unit": "°F",
          "defaultValue": 70
        }
      ],
      "outputs": [
        {
          "id": "sat_vapor_pressure",
          "label": "Saturated Water Vapor Pressure",
          "unit": "inches of Mercury",
          "formula": "inputs.dry_bulb_temp * 0.00369 + 0.0039",
          "format": "decimal"
        },
        {
          "id": "humidity_grains_per_ft3",
          "label": "Heat Dry Air (Grains per Cu. Ft. of Vapor)",
          "unit": "Grains per Cu. Ft.",
          "formula": "inputs.dry_bulb_temp * 0.1124 + 0.054",
          "format": "decimal"
        },
        {
          "id": "saturation_humidity",
          "label": "Air Saturated with Water Vapor",
          "unit": "Grains per Pound of Dry Air",
          "formula": "inputs.dry_bulb_temp * 1.56 + 0.569",
          "format": "decimal"
        },
        {
          "id": "wet_bulb_temp",
          "label": "Wet Bulb Temperature",
          "unit": "°F",
          "formula": "inputs.dry_bulb_temp * 0.24",
          "format": "decimal"
        },
        {
          "id": "specific_volume",
          "label": "Specific Volume",
          "unit": "Cu. Ft.",
          "formula": "661.4 - inputs.dry_bulb_temp * 0.24",
          "format": "decimal"
        },
        {
          "id": "dry_air_weight",
          "label": "Dry Air Weight in 1 Cu. Ft.",
          "unit": "lb/Cu. Ft.",
          "formula": "0.0764",
          "format": "decimal"
        },
        {
          "id": "enthalpy",
          "label": "Total Enthalpy",
          "unit": "Btu",
          "formula": "inputs.dry_bulb_temp * 0.24 + 0.846",
          "format": "decimal"
        }
      ]
    },
    {

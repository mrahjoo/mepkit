{
  "id": "three_phase_electrical_motors___power_factor_vs__i",
  "title": "Three-Phase Electrical Motors - Power Factor vs. Inductive Load",
  "description": "Calculate power factor, active power, reactive power, and apparent power for three-phase electric motors. Understand the relationship between power factor, inductive loads, and system efficiency.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "power_factor_calculator",
      "content": "Power Factor Calculations for Three-Phase Motors",
      "inputs": [
        {
          "id": "voltage",
          "label": "Voltage (V)",
          "type": "number",
          "defaultValue": 400,
          "unit": "V"
        },
        {
          "id": "current",
          "label": "Current (A)",
          "type": "number",
          "defaultValue": 200,
          "unit": "A"
        },
        {
          "id": "power_factor",
          "label": "Power Factor (cos φ)",
          "type": "number",
          "defaultValue": 0.7,
          "unit": ""
        },
        {
          "id": "sqrt3",
          "label": "√3 constant",
          "type": "number",
          "defaultValue": 1.732,
          "unit": ""
        }
      ],
      "outputs": [
        {
          "id": "active_power",
          "label": "Active Power (P)",
          "formula": "inputs.sqrt3 * inputs.voltage * inputs.current * inputs.power_factor",
          "unit": "W",
          "format": "decimal"
        },
        {
          "id": "apparent_power",
          "label": "Apparent Power (S)",
          "formula": "inputs.sqrt3 * inputs.voltage * inputs.current",
          "unit": "VA",
          "format": "decimal"
        },
        {
          "id": "reactive_power",
          "label": "Reactive Power (Q)",
          "formula": "Math.sqrt(Math.pow(inputs.sqrt3 * inputs.voltage * inputs.current, 2) - Math.pow(inputs.sqrt3 * inputs.voltage * inputs.current * inputs.power_factor, 2))",
          "unit": "VAR",
          "format": "decimal"
        },
        {
          "id": "phase_angle",
          "label": "Phase Angle (φ)",
          "formula": "Math.acos(inputs.power_factor) * 180 / Math.PI",
          "unit": "°",
          "format": "decimal"
        }
      ]
    },
    {

{
  "id": "butane___density_and_specific_weight_vs__temperatu",
  "title": "Butane - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculator to estimate the density and specific weight of butane at given temperature and atmospheric pressure. Outputs density in multiple units (kg/m³, lb/ft³, lb/gal(US liq), sl/ft³) and specific weight (N/m³, lbf/ft³).",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "temperature_celsius",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "pressure_bar",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bar"
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "inputs.temperature_celsius > -0.8 ? 0.0412 * (26.9 - inputs.temperature_celsius) + 570.7 : 601.6 - 0.3 * (inputs.temperature_celsius + 0.8)"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.06243"
        },
        {
          "id": "density_lb_gal",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.008345"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 0.001940"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "format": "decimal",
          "formula": "inputs.density_kg_m3 * 9.80665"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "inputs.density_lb_ft3 * 0.3108"
        }
      ]
    },

{
  "id": "heat_index",
  "title": "Heat Index Calculator",
  "description": "The heat index can be used to indicate how an average person will perceive temperature and humidity and the human body ability to cool itself. This tool calculates the heat index in degrees Fahrenheit based on air temperature and relative humidity.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "heat_index_calc",
      "content": "Heat Index Calculator (Fahrenheit)",
      "headers": [
        "Input",
        "Value"
      ],
      "inputs": [
        {
          "id": "temperature",
          "label": "Air Temperature",
          "type": "number",
          "unit": "°F",
          "defaultValue": 85
        },
        {
          "id": "humidity",
          "label": "Relative Humidity",
          "type": "number",
          "unit": "%",
          "defaultValue": 60
        }
      ],
      "outputs": [
        {
          "id": "heat_index_result",
          "label": "Heat Index",
          "unit": "°F",
          "formula": "-42.379 + 2.04901523 * inputs.temperature + 10.14333127 * inputs.humidity - 0.22475541 * inputs.temperature * inputs.humidity - 0.00683783 * inputs.temperature * inputs.temperature - 0.05481717 * inputs.humidity * inputs.humidity + 0.00122874 * inputs.temperature * inputs.temperature * inputs.humidity + 0.00085282 * inputs.temperature * inputs.humidity * inputs.humidity - 0.00000199 * inputs.temperature * inputs.humidity * inputs.temperature * inputs.humidity",
          "format": "decimal"
        }
      ]
    },

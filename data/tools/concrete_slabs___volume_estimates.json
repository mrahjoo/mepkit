{
  "id": "concrete_slabs___volume_estimates",
  "title": "Concrete Slabs - Volume Estimates",
  "description": "Estimate required concrete volume per sq. ft. using slab dimensions and depth. Required concrete is calculated in cubic yards (cy) using the formula: v = 0.0031 × l × w × t",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "concrete_calculator",
      "content": "Calculate concrete volume required for concrete slabs",
      "inputs": [
        {
          "id": "length",
          "label": "Slab Length",
          "type": "number",
          "unit": "ft",
          "defaultValue": 10
        },
        {
          "id": "width",
          "label": "Slab Width",
          "type": "number",
          "unit": "ft",
          "defaultValue": 10
        },
        {
          "id": "depth",
          "label": "Slab Depth",
          "type": "number",
          "unit": "in",
          "defaultValue": 4
        }
      ],
      "outputs": [
        {
          "id": "volume",
          "label": "Required Concrete Volume",
          "unit": "cy",
          "formula": "inputs.length * inputs.width * inputs.depth * 0.0031",
          "format": "decimal"
        },
        {
          "id": "volume_cubic_feet",
          "label": "Required Concrete Volume",
          "unit": "cu.ft.",
          "formula": "inputs.length * inputs.width * inputs.depth * 0.0031 * 27",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "volume_per_sqft_table",
      "content": "Concrete Volume per Square Foot by Depth",

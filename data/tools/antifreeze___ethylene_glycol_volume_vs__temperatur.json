{
  "id": "antifreeze___ethylene_glycol_volume_vs__temperatur",
  "title": "Antifreeze - Ethylene Glycol Volume vs. Temperature Rating",
  "description": "Calculate the volume change of ethylene glycol based on temperature variations. This tool helps determine how antifreeze volume changes with temperature fluctuations, useful for cooling system design and maintenance.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "initial_volume",
          "label": "Initial Volume",
          "type": "number",
          "defaultValue": 1,
          "unit": "L"
        },
        {
          "id": "initial_temperature",
          "label": "Initial Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "final_temperature",
          "label": "Final Temperature",
          "type": "number",
          "defaultValue": 100,
          "unit": "°C"
        },
        {
          "id": "volumetric_expansion_coefficient",
          "label": "Volumetric Expansion Coefficient",
          "type": "number",
          "defaultValue": 0.000465,
          "unit": "1/°C"
        }
      ],
      "outputs": [
        {
          "id": "temperature_change",
          "label": "Temperature Change",
          "formula": "inputs.final_temperature - inputs.initial_temperature",
          "unit": "°C",
          "format": "decimal"
        },
        {
          "id": "volume_change",
          "label": "Volume Change",
          "formula": "inputs.initial_volume * inputs.volumetric_expansion_coefficient * (inputs.final_temperature - inputs.initial_temperature)",
          "unit": "L",
          "format": "decimal"
        },
        {
          "id": "final_volume",
          "label": "Final Volume",
          "formula": "inputs.initial_volume + (inputs.initial_volume * inputs.volumetric_expansion_coefficient * (inputs.final_temperature - inputs.initial_temperature))",
          "unit": "L",
          "format": "decimal"
        },
        {
          "id": "percent_volume_change",
          "label": "Percent Volume Change",
          "formula": "(inputs.initial_volume * inputs.volumetric_expansion_coefficient * (inputs.final_temperature - inputs.initial_temperature)) / inputs.initial_volume * 100",
          "unit": "%",
          "format": "decimal"
        }
      ]
    }
  ]
}
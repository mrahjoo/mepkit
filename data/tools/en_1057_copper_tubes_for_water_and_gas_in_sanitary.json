{
  "id": "en_1057_copper_tubes_for_water_and_gas_in_sanitary",
  "title": "EN 1057 Copper Tubes - Dimensions Calculator",
  "description": "Calculator for EN 1057 Copper and copper alloys - Seamless, round copper tubes for water and gas in sanitary and heating applications. Calculate inner diameter and cross-sectional area based on nominal outside diameter and wall thickness.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "copper_tubes_calculator",
      "headers": [
        "Parameter",
        "Value"
      ],
      "inputs": [
        {
          "id": "nominal_od",
          "label": "Nominal Outside Diameter (d)",
          "type": "number",
          "unit": "mm",
          "defaultValue": 12
        },
        {
          "id": "wall_thickness",
          "label": "Nominal Wall Thickness (e)",
          "type": "number",
          "unit": "mm",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "inner_diameter",
          "label": "Inner Diameter",
          "unit": "mm",
          "formula": "inputs.nominal_od - (2 * inputs.wall_thickness)",
          "format": "decimal"
        },
        {
          "id": "cross_section_area",
          "label": "Cross-Sectional Area",
          "unit": "mm²",
          "formula": "(Math.PI / 4) * (inputs.nominal_od * inputs.nominal_od - (inputs.nominal_od - 2 * inputs.wall_thickness) * (inputs.nominal_od - 2 * inputs.wall_thickness))",
          "format": "decimal"
        },
        {
          "id": "tube_designation",
          "label": "Tube Designation Example",
          "formula": "'EN 1057 R250 ' + inputs.nominal_od + '×' + inputs.wall_thickness",
          "format": "decimal"
        }
      ]
    },
    {

{
  "id": "electrical_induction_motors___synchronous_speed",
  "title": "Electrical Induction Motors - Synchronous Speed",
  "description": "Calculate the synchronous speed of an induction motor based on power supply frequency and number of poles. The synchronous speed is determined by the formula: n = f (2 / p) 60, where n is shaft rotation speed (rpm), f is frequency (Hz), and p is the number of poles.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "id": "synchronous_speed_calculator",
      "content": "Synchronous Speed Calculator",
      "headers": [
        "Input",
        "Value",
        "Unit"
      ],
      "inputs": [
        {
          "id": "frequency",
          "label": "Frequency",
          "type": "number",
          "defaultValue": 50,
          "unit": "Hz"
        },
        {
          "id": "poles",
          "label": "Number of Poles",
          "type": "number",
          "defaultValue": 2,
          "unit": "poles"
        }
      ],
      "outputs": [
        {
          "id": "synchronous_speed",
          "label": "Synchronous Speed",
          "formula": "inputs.frequency * (2 / inputs.poles) * 60",
          "unit": "rpm",
          "format": "decimal"
        }
      ]
    },

{
  "id": "sound_propagation___the_inverse_square_law",
  "title": "Sound Propagation - the Inverse Square Law",
  "description": "Calculate sound pressure level reduction based on distance from source using the Inverse Square Law. In a free field, doubling the distance reduces sound pressure level by 6 decibels.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "inverse_square_calculator",
      "content": "Calculate the sound pressure level at a new distance using the Inverse Square Law formula: Lp2 = Lp1 - 20 * log(R2/R1)",
      "inputs": [
        {
          "id": "lp1",
          "label": "Lp1 - Sound pressure level at location 1",
          "type": "number",
          "unit": "dB",
          "defaultValue": 110
        },
        {
          "id": "r1",
          "label": "R1 - Distance from source to location 1",
          "type": "number",
          "unit": "m",
          "defaultValue": 1
        },
        {
          "id": "r2",
          "label": "R2 - Distance from source to location 2",
          "type": "number",
          "unit": "m",
          "defaultValue": 5
        }
      ],
      "outputs": [
        {
          "id": "dl",
          "label": "dL - Difference in sound pressure level",
          "unit": "dB",
          "formula": "20 * Math.log10(inputs.r2 / inputs.r1)",
          "format": "decimal"
        },
        {
          "id": "lp2",
          "label": "Lp2 - Sound pressure level at location 2",
          "unit": "dB",
          "formula": "inputs.lp1 - (20 * Math.log10(inputs.r2 / inputs.r1))",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",

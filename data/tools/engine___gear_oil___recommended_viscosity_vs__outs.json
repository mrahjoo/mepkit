          "label": "Selected Oil Viscosity",
          "formula": "inputs.oil_type"
        },
        {
          "id": "temp_celsius",
          "label": "Temperature (Celsius)",
          "formula": "(inputs.ambient_temp_f - 32) * 5 / 9",
          "unit": "°C",
          "format": "decimal"
        }
      ]
    },

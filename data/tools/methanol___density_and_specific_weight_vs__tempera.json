{
  "id": "methanol___density_and_specific_weight_vs__tempera",
  "title": "Methanol - Density and Specific Weight vs. Temperature",
  "description": "Calculator for methanol density and specific weight at varying temperature and atmospheric pressure. Calculates density in kg/m³, lb/ft³, lb/gal(US liq), and sl/ft³, as well as specific weight in N/m³ and lbf/ft³.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "methanol_density_calc",
      "content": "Methanol Density and Specific Weight Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "options": [
            {
              "value": "C",
              "label": "°C"
            },
            {
              "value": "F",
              "label": "°F"
            },
            {
              "value": "K",
              "label": "K"
            },
            {
              "value": "R",
              "label": "°R"
            }
          ],
          "defaultValue": "C"
        }
      ],
      "outputs": [
        {
          "id": "density_kgm3",
          "label": "Density",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? 791.7 - (inputs.temperature * 0.48) : 791.7"
        },
        {
          "id": "density_lbft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? (791.7 - inputs.temperature * 0.48) * 0.06243 : 791.7 * 0.06243"
        },
        {
          "id": "density_lbgal",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? (791.7 - inputs.temperature * 0.48) * 0.008345 : 791.7 * 0.008345"
        },
        {
          "id": "density_slft3",
          "label": "Density",
          "unit": "sl/ft³",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? (791.7 - inputs.temperature * 0.48) / 515.3788 : 791.7 / 515.3788"
        },
        {
          "id": "specific_weight_nm3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? (791.7 - inputs.temperature * 0.48) * 9.80665 : 791.7 * 9.80665"
        },
        {
          "id": "specific_weight_lbfft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "format": "decimal",
          "formula": "inputs.temperature >= 0.8 || inputs.temp_unit !== 'C' ? (791.7 - inputs.temperature * 0.48) * 0.06243 * 0.3108 : 791.7 * 0.06243 * 0.3108"
        }
      ]
    }
  ]
}
{
  "id": "firefighting_water___required_volume_flow",
  "title": "Firefighting Water - Required Volume Flow",
  "description": "Required water for firefighting. Water demand for firefighting can be estimated using the formula Q = 1020 n^(1/2) (1 - 0.01 n^(1/2)) where Q is water demand in gpm and n is population in thousands.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "content": "Calculate firefighting water demand based on population",
      "inputs": [
        {
          "id": "population",
          "label": "Population",
          "type": "number",
          "unit": "thousands",
          "defaultValue": 100
        }
      ],
      "outputs": [
        {
          "id": "water_demand_gpm",
          "label": "Water Demand",
          "unit": "gpm",
          "formula": "1020 * Math.sqrt(inputs.population) * (1 - 0.01 * Math.sqrt(inputs.population))",
          "format": "decimal"
        },
        {
          "id": "water_demand_m3h",
          "label": "Water Demand",
          "unit": "m³/h",
          "formula": "1020 * Math.sqrt(inputs.population) * (1 - 0.01 * Math.sqrt(inputs.population)) * 0.227",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Population (thousands)",

{
  "id": "smaller_circles_within_a_large_circle___calculator",
  "title": "Smaller Circles within a Large Circle - Calculator",
  "description": "Calculate the number of small circles that fits into an outer larger circle - ex. how many pipes or wires fits into a larger pipe or conduit.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "headers": [
        "Input Parameters"
      ],
      "inputs": [
        {
          "id": "outer_diameter",
          "label": "Outside Diameter of Outer Circle",
          "type": "number",
          "defaultValue": 10,
          "unit": "inch"
        },
        {
          "id": "inner_diameter",
          "label": "Outside Diameter of Small Circle",
          "type": "number",
          "defaultValue": 2,
          "unit": "inch"
        }
      ],
      "outputs": [
        {
          "id": "number_of_circles",
          "label": "Maximum Number of Small Circles",
          "formula": "floor(((inputs.outer_diameter - inputs.inner_diameter) / (2 * inputs.inner_diameter)) + 1) ** 2",
          "format": "decimal"
        },
        {
          "id": "packing_efficiency",
          "label": "Packing Efficiency",
          "formula": "(inputs.number_of_circles * (inputs.inner_diameter / 2) ** 2 * 3.14159) / ((inputs.outer_diameter / 2) ** 2 * 3.14159) * 100",
          "unit": "%",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Iteration",
        "Small Pipe Diameter (inch)",
        "Large Pipe Diameter (inch)",
        "Number of Pipes"
      ],
      "rows": [
        [
          "1",
          "1.5",
          "10",
          "32"
        ],
        [
          "2",
          "1.5",
          "9",
          "26"
        ],
        [
          "3",
          "1.5",
          "9.8",
          "31"
        ],
        [
          "4",
          "1.5",
          "9.6",
          "29"
        ],
        [
          "5",
          "1.5",
          "9.7",
          "31"
        ],
        [
          "6",
          "1.5",
          "9.65",
          "30"
        ]
      ]
    },
    {
      "type": "chart",
      "options": {
        "title": {
          "text": "Packing Efficiency vs Circle Ratio"
        },
        "tooltip": {
          "trigger": "axis"
        },
        "xAxis": {
          "type": "category",
          "data": [
            "1:1",
            "1:2",
            "1:3",
            "1:4",
            "1:5"
          ]
        },
        "yAxis": {
          "type": "value",
          "name": "Number of Circles"
        },
        "series": [
          {
            "name": "Maximum Circles",
            "data": [
              1,
              4,
              9,
              16,
              25
            ],
            "type": "line",
            "smooth": true
          }
        ]
      }
    }
  ]
}
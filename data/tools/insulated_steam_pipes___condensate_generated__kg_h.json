{
  "id": "insulated_steam_pipes___condensate_generated__kg_h",
  "title": "Insulated Steam Pipes - Condensate Generated (kg/h per 100m)",
  "description": "Calculate condensate generated due to heat loss in insulated steam pipes. Heat loss from steam pipes generates condensate which must be drained from the system. This tool uses a lookup table based on steam pressure and pipe size, with surrounding temperature of 20°C and 80% insulation efficiency.",
  "type": "calculator",

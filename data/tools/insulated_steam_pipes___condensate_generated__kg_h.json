      ],
      "outputs": [
        {
          "id": "condensate_generation",
          "label": "Condensate Generation",
          "unit": "kg/h per 100m",
          "format": "decimal",
          "formula": "lookupCondensateValue(inputs.steam_pressure, inputs.pipe_size) * inputs.temperature_adjustment"
        }
      ]
    },

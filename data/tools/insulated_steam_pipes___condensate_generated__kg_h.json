        },
        {
          "id": "temperature_adjustment",
          "label": "Temperature Adjustment Factor",
          "type": "select",
          "options": [
            {
              "value": 1,
              "label": "20°C (Standard)"
            },
            {
              "value": 1.5,
              "label": "-20°C (Add 50%)"
            }
          ],
          "defaultValue": 1

    {
      "type": "calculator",
      "inputs": [
        {
          "id": "battery_capacity",
          "label": "Battery Capacity",
          "type": "number",
          "defaultValue": 3000,
          "unit": "mAh"
        },
        {
          "id": "device_consumption",
          "label": "Device Consumption",
          "type": "number",
          "defaultValue": 500,
          "unit": "mA"
        },
        {
          "id": "usable_energy",
          "label": "Usable Energy",
          "type": "number",
          "defaultValue": 80,
          "unit": "%"
        }
      ],
      "outputs": [
        {
          "id": "battery_life_hours",
          "label": "Battery Life",
          "formula": "(inputs.battery_capacity * inputs.usable_energy / 100) / inputs.device_consumption",
          "unit": "hours",
          "format": "decimal"
        },
        {
          "id": "battery_life_minutes",
          "label": "Battery Life",
          "formula": "((inputs.battery_capacity * inputs.usable_energy / 100) / inputs.device_consumption) * 60",
          "unit": "minutes",
          "format": "decimal"
        }

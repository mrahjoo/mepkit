    {
      "type": "calculator",
      "inputs": [
        {
          "id": "cd",
          "label": "Discharge Coefficient (cd)",
          "type": "number",
          "defaultValue": 0.6
        },
        {
          "id": "D2",
          "label": "Orifice/Meter Diameter (m)",
          "type": "number",
          "defaultValue": 0.05,
          "unit": "m"
        },
        {
          "id": "D1",
          "label": "Pipe Diameter (m)",
          "type": "number",
          "defaultValue": 0.102,
          "unit": "m"
        },
        {
          "id": "p1",
          "label": "Upstream Pressure (Pa)",
          "type": "number",
          "defaultValue": 20000,
          "unit": "Pa"
        },
        {
          "id": "p2",
          "label": "Downstream Pressure (Pa)",
          "type": "number",
          "defaultValue": 0,
          "unit": "Pa"
        },
        {
          "id": "rho",
          "label": "Fluid Density (kg/m³)",
          "type": "number",
          "defaultValue": 1000,
          "unit": "kg/m³"
        }
      ],
      "outputs": [
        {
          "id": "d_ratio",
          "label": "Diameter Ratio (d)",
          "formula": "inputs.D2 / inputs.D1",
          "format": "decimal"
        },
        {
          "id": "A1",
          "label": "Upstream Area (m²)",
          "formula": "(3.14159 / 4) * inputs.D1 * inputs.D1",
          "unit": "m²",
          "format": "decimal"
        },
        {
          "id": "A2",
          "label": "Meter Area (m²)",
          "formula": "(3.14159 / 4) * inputs.D2 * inputs.D2",
          "unit": "m²",
          "format": "decimal"
        },
        {
          "id": "dp",
          "label": "Pressure Difference (Pa)",
          "formula": "inputs.p1 - inputs.p2",
          "unit": "Pa",
          "format": "decimal"
        },
        {
          "id": "mass_flow",
          "label": "Mass Flow (kg/s)",
          "formula": "inputs.cd * (3.14159 / 4) * inputs.D2 * inputs.D2 * inputs.rho * Math.sqrt(2 * (inputs.p1 - inputs.p2) / (inputs.rho * (1 - Math.pow(inputs.D2 / inputs.D1, 4))))",
          "unit": "kg/s",
          "format": "decimal"
        },
        {
          "id": "volume_flow",
          "label": "Volume Flow (m³/s)",
          "formula": "inputs.cd * (3.14159 / 4) * inputs.D2 * inputs.D2 * Math.sqrt(2 * (inputs.p1 - inputs.p2) / (inputs.rho * (1 - Math.pow(inputs.D2 / inputs.D1, 4))))",
          "unit": "m³/s",
          "format": "decimal"
        }
      ]
    }

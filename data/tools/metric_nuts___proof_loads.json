            },
            {
              "value": "M30",
              "label": "M30"
            },
            {
              "value": "M33",
              "label": "M33"
            },
            {
              "value": "M36",
              "label": "M36"
            },
            {
              "value": "M39",
              "label": "M39"
            }
          ],
          "defaultValue": "M8"
        },
        {
          "id": "property_class",
          "label": "Property Class",
          "type": "select",
          "options": [
            {
              "value": "5",
              "label": "5"
            },
            {
              "value": "6",
              "label": "6"
            },
            {
              "value": "8",
              "label": "8"
            },
            {
              "value": "9",
              "label": "9"
            },
            {
              "value": "10",
              "label": "10"
            },
            {
              "value": "12",
              "label": "12"
            }
          ],
          "defaultValue": "8"
        }
      ],
      "outputs": [
        {
          "id": "proof_load",
          "label": "Proof Load - Fp",
          "unit": "N",
          "formula": "inputs.property_class === '5' ? 13900 : inputs.property_class === '6' ? 18300 : inputs.property_class === '8' ? 21600 : inputs.property_class === '9' ? 24900 : inputs.property_class === '10' ? 31800 : 34400",
          "format": "decimal"
        }
      ]
    },

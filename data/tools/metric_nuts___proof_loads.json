{
  "id": "metric_nuts___proof_loads",
  "title": "Metric Nuts - Proof Loads",
  "description": "Proof loads of metric nuts - coarse and fine threads according to ISO 898-1. Calculate and lookup proof loads for various thread sizes and property classes.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "proof_load_lookup",
      "content": "Select metric nut specifications to find proof load values",
      "inputs": [
        {
          "id": "thread_type",
          "label": "Thread Type",
          "type": "select",
          "options": [
            {
              "value": "coarse",
              "label": "Coarse Thread"
            },
            {
              "value": "fine",
              "label": "Fine Thread"
            }
          ],
          "defaultValue": "coarse"
        },
        {
          "id": "thread_size",
          "label": "Thread Size (M)",
          "type": "select",
          "options": [

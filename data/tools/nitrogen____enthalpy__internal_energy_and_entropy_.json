{
  "id": "nitrogen____enthalpy__internal_energy_and_entropy_",
  "title": "Nitrogen - Enthalpy, Internal Energy and Entropy vs. Temperature",
  "description": "Calculate enthalpy, internal energy, and entropy properties of nitrogen as a function of temperature.",
  "type": "datatable",
  "components": [
    {
      "type": "calculator",
      "content": "Nitrogen Thermodynamic Properties Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "unit": "K",
          "defaultValue": 298.15
        }
      ],
      "outputs": [
        {
          "id": "enthalpy",
          "label": "Enthalpy",
          "unit": "kJ/kmol",
          "formula": "inputs.temperature * 0.0291",
          "format": "decimal"
        },
        {
          "id": "internal_energy",
          "label": "Internal Energy",
          "unit": "kJ/kmol",
          "formula": "inputs.temperature * 0.0208",
          "format": "decimal"
        },
        {
          "id": "entropy",
          "label": "Entropy",
          "unit": "kJ/(kmol·K)",
          "formula": "inputs.temperature * 0.00691",
          "format": "decimal"
        }
      ]
    },
    {

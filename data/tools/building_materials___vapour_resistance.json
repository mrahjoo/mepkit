{
  "id": "building_materials___vapour_resistance",
  "title": "Building Materials - Vapour Resistance",
  "description": "Diffusion of vapor through building materials. Calculate vapor resistance based on material thickness and vapor resistivity.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "content": "Vapor Resistance Calculator",
      "inputs": [
        {
          "id": "thickness",
          "label": "Thickness of Material",
          "type": "number",
          "unit": "m",
          "defaultValue": 0.1
        },
        {
          "id": "vapor_resistivity",
          "label": "Vapor Resistivity",
          "type": "number",
          "unit": "G Ns/(kg m)",
          "defaultValue": 100
        }
      ],
      "outputs": [
        {
          "id": "vapor_resistance",
          "label": "Vapor Resistance",
          "formula": "inputs.thickness * inputs.vapor_resistivity",
          "unit": "Ns/kg",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Material",
        "Vapor Resistivity (G Ns/(kg m))"
      ],
      "rows": [
        [

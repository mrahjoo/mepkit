{
  "id": "air___density_and_specific_volume_vs__altitude",
  "title": "Air - Density and Specific Volume vs. Altitude",
  "description": "Calculate and visualize air density and specific volume as functions of altitude above sea level. The tool provides pressure-altitude relationships, density corrections, and volume correction factors based on standard atmospheric conditions.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "density_calculator",
      "content": "Air Density and Specific Volume Calculator",
      "headers": [
        "Inputs",
        "Outputs"
      ],
      "inputs": [
        {
          "id": "altitude_m",
          "label": "Altitude",
          "type": "number",
          "unit": "m",
          "defaultValue": 0
        },
        {
          "id": "temperature_c",
          "label": "Temperature",
          "type": "number",
          "unit": "°C",
          "defaultValue": 20
        },
        {
          "id": "reference_density",
          "label": "Reference Density (at sea level, 20°C)",
          "type": "number",
          "unit": "kg/m³",
          "defaultValue": 1.204
        }
      ],
      "outputs": [
        {
          "id": "pressure_kpa",
          "label": "Atmospheric Pressure",
          "unit": "kPa",
          "formula": "101.325 * (1 - 0.0065 * inputs.altitude_m / 288.15) ^ 5.255",
          "format": "decimal"
        },
        {
          "id": "density_kgm3",
          "label": "Air Density",
          "unit": "kg/m³",
          "formula": "inputs.reference_density * (1 - 0.0065 * inputs.altitude_m / 288.15) ^ 4.255 * 293.15 / (inputs.temperature_c + 273.15)",
          "format": "decimal"
        },
        {
          "id": "specific_volume",
          "label": "Specific Volume",
          "unit": "m³/kg",
          "formula": "1 / (inputs.reference_density * (1 - 0.0065 * inputs.altitude_m / 288.15) ^ 4.255 * 293.15 / (inputs.temperature_c + 273.15))",
          "format": "decimal"
        }
      ]
    },
    {

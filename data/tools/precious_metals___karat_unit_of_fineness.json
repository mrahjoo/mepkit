{
  "id": "precious_metals___karat_unit_of_fineness",
  "title": "Precious Metals - Karat Unit of Fineness",
  "description": "Units of fineness - Karat. Calculate gold fineness conversions between karat, decimal, percentage, and o/oo (parts per thousand) measurements.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "headers": [
        "Karat to Fineness Converter"
      ],
      "inputs": [
        {
          "id": "karat_value",
          "label": "Karat Value",
          "type": "number",
          "defaultValue": 18,
          "unit": "K"
        }
      ],
      "outputs": [
        {
          "id": "fraction",
          "label": "Fraction",
          "formula": "inputs.karat_value / 24"
        },
        {
          "id": "decimal",
          "label": "Decimal",
          "formula": "inputs.karat_value / 24",
          "format": "decimal"
        },
        {
          "id": "percentage",
          "label": "Percentage",
          "formula": "(inputs.karat_value / 24) * 100",
          "unit": "%",
          "format": "decimal"
        },
        {
          "id": "per_thousand",
          "label": "Parts Per Thousand",
          "formula": "(inputs.karat_value / 24) * 1000",
          "unit": "o/oo",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "headers": [
        "Karat",
        "Fraction",
        "Decimal",
        "Percentage",
        "o/oo (Parts per Thousand)",
        "Use Case"
      ],
      "rows": [
        [

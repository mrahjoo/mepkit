{
  "id": "mild_steel___round_bars_weight",
  "title": "Mild Steel - Round Bars Weight",
  "description": "Weight of round bars. Calculate the weight of mild steel round bars using the formula W = 0.0062 d²",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "content": "Calculate the weight of mild steel round bars based on diameter",
      "inputs": [
        {
          "id": "diameter",
          "label": "Bar Diameter",
          "type": "number",
          "unit": "mm",
          "defaultValue": 20
        }
      ],
      "outputs": [
        {
          "id": "weight",
          "label": "Weight",
          "unit": "kg/m",
          "formula": "inputs.diameter * inputs.diameter * 0.0062",
          "format": "decimal"
        }
      ]
    },
    {

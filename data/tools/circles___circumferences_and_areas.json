{
  "id": "circles___circumferences_and_areas",
  "title": "Circles - Circumferences and Areas",
  "description": "Circumferences and areas of circles with diameters in inches. Calculate circle properties using diameter measurements.",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "content": "Calculate circle circumference and area from diameter",
      "inputs": [
        {
          "id": "diameter",
          "label": "Diameter",
          "type": "number",
          "unit": "inches",
          "defaultValue": 1
        }
      ],
      "outputs": [
        {
          "id": "circumference",
          "label": "Circumference",
          "unit": "inches",
          "formula": "inputs.diameter * 3.14159265359",
          "format": "decimal"
        },
        {
          "id": "area",
          "label": "Area",
          "unit": "in²",
          "formula": "(inputs.diameter / 2) * (inputs.diameter / 2) * 3.14159265359",
          "format": "decimal"
        }
      ]
    },

{
  "id": "circle___the_chord_lengths_when_divided_in_to_equa",
  "title": "Circle - Chord Lengths when Divided into Equal Segments",
  "description": "Calculate chord lengths when dividing the circumference of a circle into an equal number of segments. This tool helps determine chord lengths for both unit circles and circles with specific radii.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "chord_calculator",
      "content": "Calculate chord lengths based on radius and number of segments",
      "inputs": [
        {
          "id": "radius",
          "label": "Radius",
          "type": "number",
          "defaultValue": 3,
          "unit": "m"
        },
        {
          "id": "segments",
          "label": "Number of Segments",
          "type": "number",
          "defaultValue": 24,
          "unit": "segments"
        }
      ],
      "outputs": [
        {
          "id": "center_angle",
          "label": "Center Angle (θ)",
          "formula": "360 / inputs.segments",
          "unit": "degrees"
        },
        {
          "id": "single_chord_length",
          "label": "Single Chord Length (L)",
          "formula": "2 * inputs.radius * Math.sin((Math.PI / 180) * (180 / inputs.segments))",
          "unit": "m"
        },
        {
          "id": "total_chord_length",
          "label": "Total Chord Length",
          "formula": "inputs.segments * 2 * inputs.radius * Math.sin((Math.PI / 180) * (180 / inputs.segments))",
          "unit": "m"
        },
        {
          "id": "circumference",
          "label": "Circle Circumference",
          "formula": "2 * Math.PI * inputs.radius",
          "unit": "m"
        }
      ]
    },
    {
      "type": "chart",
      "id": "chord_visualization",
      "content": "Visualization of chord lengths as the number of segments increases",
      "options": {

    {
      "type": "calculator",
      "content": "## Calculate Load in kN from Mass\n\nUse the formula: **F = m × g / 1000**\n\nWhere:\n- F = load (kN)\n- m = mass (kg)\n- g = gravitational acceleration (9.81 m/s²)",
      "inputs": [
        {
          "id": "mass",
          "label": "Mass",
          "type": "number",
          "unit": "kg",
          "defaultValue": 800
        }
      ],
      "outputs": [
        {
          "id": "load",
          "label": "Load",
          "formula": "inputs.mass * 9.81 / 1000",
          "unit": "kN",
          "format": "decimal"
        }
      ]
    },

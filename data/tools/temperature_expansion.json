          "Ceramics"
        ],
        [
          "Concrete",
          "0.000012",
          "Ceramics"
        ]
      ]
    },
    {
      "type": "chart",
      "content": "Thermal expansion comparison across different materials",
      "options": {
        "title": {
          "text": "Linear Expansion Coefficients by Material"
        },
        "tooltip": {
          "trigger": "axis"
        },

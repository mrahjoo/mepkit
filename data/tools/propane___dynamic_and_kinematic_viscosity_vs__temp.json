{
  "id": "propane___dynamic_and_kinematic_viscosity_vs__temp",
  "title": "Propane - Dynamic and Kinematic Viscosity vs. Temperature",
  "description": "Calculate dynamic and kinematic viscosity of propane at given temperatures and atmospheric pressure. Viscosity is a measure of fluid resistance to deformation by shear stress.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "viscosity_calculator",
      "content": "Propane Viscosity Calculator - Atmospheric Pressure",
      "inputs": [
        {
          "id": "temperature_value",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "temperature_unit",
          "label": "Temperature Unit",
          "type": "select",
          "options": [
            {
              "label": "Celsius (°C)",
              "value": "C"
            },
            {
              "label": "Fahrenheit (°F)",
              "value": "F"
            },
            {
              "label": "Kelvin (K)",
              "value": "K"
            },
            {
              "label": "Rankine (°R)",
              "value": "R"
            }
          ],
          "defaultValue": "C"
        },
        {
          "id": "viscosity_type",
          "label": "Viscosity Type",
          "type": "select",
          "options": [
            {
              "label": "Dynamic (Absolute)",
              "value": "dynamic"
            },
            {
              "label": "Kinematic",
              "value": "kinematic"
            }
          ],
          "defaultValue": "dynamic"
        }
      ],
      "outputs": [
        {
          "id": "dynamic_viscosity_pas",
          "label": "Dynamic Viscosity",
          "unit": "Pa·s",
          "formula": "inputs.temperature_value > 100 ? inputs.temperature_value * 0.1 : inputs.temperature_value * 0.05",
          "format": "decimal"
        },
        {
          "id": "dynamic_viscosity_cp",
          "label": "Dynamic Viscosity",
          "unit": "cP",
          "formula": "inputs.temperature_value > 100 ? inputs.temperature_value * 10 : inputs.temperature_value * 5",
          "format": "decimal"
        },
        {
          "id": "kinematic_viscosity_cst",
          "label": "Kinematic Viscosity",
          "unit": "cSt",
          "formula": "inputs.temperature_value > 100 ? inputs.temperature_value * 0.5 : inputs.temperature_value * 0.25",
          "format": "decimal"
        },
        {
          "id": "kinematic_viscosity_m2s",
          "label": "Kinematic Viscosity",
          "unit": "m²/s",
          "formula": "inputs.temperature_value > 100 ? inputs.temperature_value * 5e-6 : inputs.temperature_value * 2.5e-6",
          "format": "scientific"
        }
      ]
    },

        {
          "id": "wall_thickness",
          "label": "Wall Thickness (inches)",
          "type": "number",
          "defaultValue": 0.1083
        },
        {
          "id": "outside_diameter",
          "label": "Outside Diameter (inches)",
          "type": "number",
          "defaultValue": 1.315
        }
      ],
      "outputs": [
        {
          "id": "inside_diameter",
          "label": "Inside Diameter",
          "formula": "inputs.outside_diameter - (2 * inputs.wall_thickness)",
          "unit": "in"
        },
        {
          "id": "cross_section_area",
          "label": "Cross-Sectional Area",
          "formula": "3.14159 * (Math.pow(inputs.outside_diameter, 2) - Math.pow(inputs.outside_diameter - (2 * inputs.wall_thickness), 2)) / 4",
          "unit": "sq in"
        },
        {
          "id": "moment_inertia",
          "label": "Moment of Inertia",
          "formula": "3.14159 * (Math.pow(inputs.outside_diameter, 4) - Math.pow(inputs.outside_diameter - (2 * inputs.wall_thickness), 4)) / 64",
          "unit": "in^4"
        }
      ]
    },

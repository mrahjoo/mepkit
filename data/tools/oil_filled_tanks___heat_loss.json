          0.35
        ],
        [
          27,
          80,
          8.5,
          1.5,
          2.1,
          0.38
        ],
        [
          38,
          100,
          9,
          1.6,
          2.3,
          0.4
        ]
      ],
      "content": "## Exposed Tank Heat Transfer Rates"
    },
    {
      "type": "calculator",
      "id": "heat_loss_calculator",
      "content": "### Heat Loss Calculator\n\nUse the formula: **Q = α A Δt**\n\nWhere:\n- Q = heat loss (W)\n- α = heat transfer rate (W/(m² °C))\n- A = surface area (m²)\n- Δt = temperature difference (°C)",
      "inputs": [
        {
          "id": "alpha",
          "label": "Heat Transfer Rate (α)",
          "type": "number",
          "unit": "W/(m² °C)",
          "defaultValue": 2.27
        },
        {
          "id": "area",
          "label": "Surface Area (A)",
          "type": "number",
          "unit": "m²",
          "defaultValue": 1000
        },
        {
          "id": "temp_diff",
          "label": "Temperature Difference (Δt)",
          "type": "number",
          "unit": "°C",
          "defaultValue": 38
        }
      ],
      "outputs": [
        {
          "id": "heat_loss_w",
          "label": "Heat Loss",
          "formula": "inputs.alpha * inputs.area * inputs.temp_diff",
          "unit": "W",
          "format": "decimal"
        },
        {
          "id": "heat_loss_kw",
          "label": "Heat Loss",
          "formula": "(inputs.alpha * inputs.area * inputs.temp_diff) / 1000",
          "unit": "kW",
          "format": "decimal"
        }
      ]
    }
  ]
}
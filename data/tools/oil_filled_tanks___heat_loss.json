      "content": "## Sheltered Tank Heat Transfer Rates"
    },
    {
      "type": "datatable",
      "id": "exposed_tanks",
      "headers": [
        "Tank Temperature (°C)",
        "Tank Temperature (°F)",
        "Uninsulated W/(m² °C)",
        "Uninsulated Btu/(hr ft² °F)",
        "Insulated W/(m² °C)",
        "Insulated Btu/(hr ft² °F)"
      ],
      "rows": [
        [
          10,
          50,
          8,
          1.4,

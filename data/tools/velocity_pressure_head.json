{
  "id": "velocity_pressure_head",
  "title": "Velocity Pressure Head Calculator",
  "description": "Calculate dynamic pressure and velocity head for water and air flows using pitot tube measurements. Supports metric and imperial units for converting between flow velocity and pressure head.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "water_velocity_calculator",
      "content": "### Water Flow - Velocity Head Calculator",
      "inputs": [
        {
          "id": "water_velocity_fps",
          "label": "Water Flow Velocity",
          "type": "number",
          "defaultValue": 5,
          "unit": "ft/sec"
        }
      ],
      "outputs": [
        {
          "id": "water_head_ft",
          "label": "Velocity Head (ft H2O)",
          "formula": "0.0155 * inputs.water_velocity_fps ^ 2",
          "unit": "ft H2O",
          "format": "decimal"
        },
        {
          "id": "water_head_in",
          "label": "Velocity Head (in H2O)",
          "formula": "0.186 * inputs.water_velocity_fps ^ 2",
          "unit": "in H2O",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "calculator",
      "id": "air_velocity_calculator",
      "content": "### Air Flow - Head to Velocity Calculator",
      "inputs": [
        {
          "id": "air_velocity_fpm",
          "label": "Air Flow Velocity",
          "type": "number",
          "defaultValue": 4000,
          "unit": "ft/min"
        },
        {
          "id": "air_temp_f",
          "label": "Air Temperature",
          "type": "number",
          "defaultValue": 70,
          "unit": "°F"
        }
      ],
      "outputs": [
        {
          "id": "air_head_in",
          "label": "Velocity Head (in H2O)",
          "formula": "(inputs.air_velocity_fpm / 4005) ^ 2",
          "unit": "in H2O",
          "format": "decimal"
        },
        {
          "id": "air_head_ft",
          "label": "Velocity Head (ft H2O)",
          "formula": "((inputs.air_velocity_fpm / 4005) ^ 2) / 12",
          "unit": "ft H2O",
          "format": "decimal"
        }
      ]
    },

{
  "id": "ethane____thermal_conductivity_vs__temperature_and",
  "title": "Ethane - Thermal Conductivity vs. Temperature and Pressure",
  "description": "Calculator for estimating the thermal conductivity of ethane at given temperature and pressure. Thermal conductivity describes the ability to conduct heat and is expressed in multiple units including mW/(m K), Btu(IT)/(h ft °F), (Btu(IT) in)/(h ft2°F) and kcal(IT)/(h m K).",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "headers": [
        "Input",
        "Value"
      ],
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 20,
          "unit": "°C"
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bara"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "options": [
            {
              "label": "Celsius (°C)",
              "value": "C"
            },
            {
              "label": "Fahrenheit (°F)",
              "value": "F"
            },
            {
              "label": "Kelvin (K)",
              "value": "K"
            },
            {
              "label": "Rankine (°R)",
              "value": "R"
            }
          ],
          "defaultValue": "C"
        }
      ],
      "outputs": [
        {
          "id": "tc_mW_mK",
          "label": "Thermal Conductivity",
          "unit": "mW/(m K)",
          "format": "decimal",
          "formula": "inputs.temperature * 0.5 + inputs.pressure * 2"
        },
        {
          "id": "tc_kcal",
          "label": "Thermal Conductivity",
          "unit": "kcal(IT)/(h m K)",
          "format": "decimal",
          "formula": "(inputs.temperature * 0.5 + inputs.pressure * 2) * 0.00086"
        },
        {
          "id": "tc_btu_hft",
          "label": "Thermal Conductivity",
          "unit": "Btu(IT)/(h ft °F)",
          "format": "decimal",
          "formula": "(inputs.temperature * 0.5 + inputs.pressure * 2) * 0.000577"
        },
        {
          "id": "tc_btu_in",
          "label": "Thermal Conductivity",
          "unit": "(Btu(IT) in)/(h ft²°F)",
          "format": "decimal",
          "formula": "(inputs.temperature * 0.5 + inputs.pressure * 2) * 0.00693"
        }
      ]
    }
  ]
}
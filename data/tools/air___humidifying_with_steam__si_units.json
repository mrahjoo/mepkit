{
  "id": "air___humidifying_with_steam__si_units",
  "title": "Air - Humidifying with Steam, SI units",
  "description": "Calculate the amount of water vapor required to humidify air using steam. This tool determines vapor content in air at different temperatures and relative humidity levels, measured in kg per 100 m³ of air volume.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "steam_humidification_calc",
      "content": "Calculate water vapor required for air humidification",
      "inputs": [
        {
          "id": "initial_temp",
          "label": "Initial Air Temperature",
          "type": "number",
          "unit": "°C",
          "defaultValue": 20
        },
        {
          "id": "initial_humidity",
          "label": "Initial Relative Humidity",
          "type": "number",
          "unit": "%",
          "defaultValue": 30
        },
        {
          "id": "final_temp",
          "label": "Final Air Temperature",
          "type": "number",
          "unit": "°C",
          "defaultValue": 20
        },
        {
          "id": "final_humidity",
          "label": "Final Relative Humidity",
          "type": "number",
          "unit": "%",
          "defaultValue": 80
        },
        {
          "id": "air_volume",
          "label": "Air Volume",
          "type": "number",
          "unit": "m³",
          "defaultValue": 100
        }
      ],
      "outputs": [
        {
          "id": "initial_vapor",
          "label": "Initial Vapor Content",
          "unit": "kg per 100 m³",
          "formula": "inputs.initial_humidity * 0.01743",
          "format": "decimal"
        },
        {
          "id": "final_vapor",
          "label": "Final Vapor Content",
          "unit": "kg per 100 m³",
          "formula": "inputs.final_humidity * 0.01390",
          "format": "decimal"
        },
        {
          "id": "vapor_required",
          "label": "Water Vapor Required",
          "unit": "kg per 100 m³",
          "formula": "(inputs.final_humidity * 0.01390) - (inputs.initial_humidity * 0.01743)",
          "format": "decimal"
        }
      ]
    },

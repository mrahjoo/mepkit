{
  "id": "plato_and_brix_vs__specific_gravity",
  "title": "Plato and Brix vs. Specific Gravity",
  "description": "Convert between units like Plato, Brix and SG (Specific Gravity) used to measure sucrose dissolved in water. Brix measures the amount of sucrose dissolved in water (expressed as % g/g), while Plato measures the weight of solids dissolved in water (also expressed in %).",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "brix",
          "label": "Brix (°Bx)",
          "type": "number",
          "defaultValue": 10,
          "unit": "°Bx"
        }
      ],
      "outputs": [
        {
          "id": "plato",
          "label": "Plato",
          "unit": "%",
          "format": "decimal",
          "formula": "inputs.brix * 1.04"
        },
        {
          "id": "sg",
          "label": "Specific Gravity (SG)",
          "unit": "kg/m³",
          "format": "decimal",
          "formula": "1000 + (inputs.brix * 4.2)"
        }
      ]
    },

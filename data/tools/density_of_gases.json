              "value": "to_kg_m3"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "format": "decimal",
          "formula": "inputs.conversion_type === 'to_lb_ft3' ? inputs.density_kgm3 * 0.0624 : inputs.density_kgm3 / 16.018"

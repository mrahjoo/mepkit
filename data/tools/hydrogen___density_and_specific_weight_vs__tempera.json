{
  "id": "hydrogen___density_and_specific_weight_vs__tempera",
  "title": "Hydrogen - Density and Specific Weight vs. Temperature and Pressure",
  "description": "Calculate and visualize the density and specific weight of gaseous hydrogen at given temperature and atmospheric pressure. Includes conversion formulas and tabulated values for SI and Imperial units.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "hydrogen_density_calculator",
      "content": "Hydrogen Density and Specific Weight Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 25,
          "unit": "°C"
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bara"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "defaultValue": "celsius",
          "options": [
            {
              "value": "celsius",
              "label": "°C"
            },
            {
              "value": "fahrenheit",
              "label": "°F"
            },
            {
              "value": "kelvin",
              "label": "K"
            },
            {
              "value": "rankine",
              "label": "°R"
            }
          ]
        },
        {
          "id": "pressure_unit",
          "label": "Pressure Unit",
          "type": "select",
          "defaultValue": "bara",
          "options": [
            {
              "value": "bara",
              "label": "bara"
            },
            {
              "value": "psia",
              "label": "psia"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "density_kg_m3",
          "label": "Density",
          "unit": "kg/m³",
          "formula": "inputs.pressure / 1 * 0.0815",
          "format": "decimal"
        },
        {
          "id": "density_lb_ft3",
          "label": "Density",
          "unit": "lb/ft³",
          "formula": "inputs.pressure / 1 * 0.00509",
          "format": "decimal"
        },
        {
          "id": "density_lb_gal_us",
          "label": "Density",
          "unit": "lb/gal(US liq)",
          "formula": "inputs.pressure / 1 * 0.0681",
          "format": "decimal"
        },
        {
          "id": "density_sl_ft3",
          "label": "Density",
          "unit": "sl/ft³",
          "formula": "inputs.pressure / 1 * 0.000158",
          "format": "decimal"
        },
        {
          "id": "specific_weight_n_m3",
          "label": "Specific Weight",
          "unit": "N/m³",
          "formula": "inputs.pressure / 1 * 0.0815 * 9.80665",
          "format": "decimal"
        },
        {
          "id": "specific_weight_lbf_ft3",
          "label": "Specific Weight",
          "unit": "lbf/ft³",
          "formula": "inputs.pressure / 1 * 0.00509 * 32.17405",
          "format": "decimal"
        }
      ]
    },
    {

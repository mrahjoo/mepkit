{
  "id": "driving_distances_between_european_cities",
  "title": "Driving Distances between European Cities",
  "description": "Calculate driving distances and convert between kilometers and miles for major European cities",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "id": "distance_converter",
      "content": "Convert driving distances between kilometers and miles",
      "inputs": [
        {
          "id": "distance_km",
          "label": "Distance (km)",
          "type": "number",
          "defaultValue": 1000,
          "unit": "km"
        }
      ],
      "outputs": [
        {
          "id": "distance_miles",
          "label": "Distance (miles)",
          "formula": "inputs.distance_km * 0.621",
          "unit": "miles",
          "format": "decimal"
        }
      ]
    },

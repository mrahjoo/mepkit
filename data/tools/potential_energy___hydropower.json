{
  "id": "potential_energy___hydropower",
  "title": "Potential Energy - Hydropower",
  "description": "Calculate elevation and potential energy in hydropower systems. Determine the increase in potential energy when a body of mass is elevated against gravitational force.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "potential_energy_calculator",
      "content": "Calculate potential energy using the formula: Ep = m × ag × Δh",
      "inputs": [
        {
          "id": "mass",
          "label": "Mass",
          "type": "number",
          "defaultValue": 1000,
          "unit": "kg"
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity",
          "type": "number",
          "defaultValue": 9.81,
          "unit": "m/s²"
        },
        {
          "id": "elevation_change",
          "label": "Change in Elevation",
          "type": "number",
          "defaultValue": 10,
          "unit": "m"
        }
      ],
      "outputs": [
        {
          "id": "potential_energy_joules",
          "label": "Potential Energy",
          "formula": "inputs.mass * inputs.gravity * inputs.elevation_change",
          "unit": "J",
          "format": "decimal"
        },
        {
          "id": "potential_energy_kj",
          "label": "Potential Energy",
          "formula": "(inputs.mass * inputs.gravity * inputs.elevation_change) / 1000",
          "unit": "kJ",
          "format": "decimal"
        },
        {
          "id": "potential_energy_kwh",
          "label": "Potential Energy",
          "formula": "(inputs.mass * inputs.gravity * inputs.elevation_change) / 3600000",
          "unit": "kWh",
          "format": "decimal"
        }
      ]
    },
    {

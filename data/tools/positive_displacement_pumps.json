    {
      "type": "calculator",
      "inputs": [
        {
          "id": "baseline_speed",
          "label": "Baseline Speed",
          "type": "number",
          "unit": "RPM",
          "defaultValue": 1000
        },
        {
          "id": "speed_reduction_percent",
          "label": "Speed Reduction",
          "type": "number",
          "unit": "%",
          "defaultValue": 20
        }
      ],
      "outputs": [
        {
          "id": "corrected_speed",
          "label": "Corrected Speed",
          "unit": "RPM",
          "formula": "inputs.baseline_speed * (1 - inputs.speed_reduction_percent / 100)",
          "format": "decimal"
        }
      ]

      "outputs": [
        {
          "id": "isa_code",
          "label": "ISA Code",
          "formula": "inputs.first_letter + (inputs.modifier_letter != 'none' ? inputs.modifier_letter : '') + inputs.second_letter + (inputs.modifier_function != 'none' ? inputs.modifier_function : '')"
        },
        {
          "id": "full_code",
          "label": "Full Identification",
          "formula": "inputs.first_letter + (inputs.modifier_letter != 'none' ? inputs.modifier_letter : '') + inputs.second_letter + (inputs.modifier_function != 'none' ? inputs.modifier_function : '') + ' ' + String(inputs.identification_number).padStart(3, '0')"
        }

      "type": "calculator",
      "content": "## Water Content Calculator",
      "inputs": [
        {
          "id": "initial_water_content",
          "label": "Initial Water Content",
          "type": "number",
          "unit": "%",
          "defaultValue": 85
        },
        {
          "id": "final_water_content",
          "label": "Final Water Content",
          "type": "number",
          "unit": "%",
          "defaultValue": 15
        },
        {
          "id": "initial_mass",
          "label": "Initial Mass",
          "type": "number",
          "unit": "kg",
          "defaultValue": 100
        }
      ],
      "outputs": [
        {
          "id": "water_removed",
          "label": "Water Removed",
          "formula": "inputs.initial_mass * (inputs.initial_water_content - inputs.final_water_content) / 100",
          "unit": "kg",
          "format": "decimal"
        },
        {
          "id": "final_mass",
          "label": "Final Mass After Drying",
          "formula": "inputs.initial_mass - (inputs.initial_mass * (inputs.initial_water_content - inputs.final_water_content) / 100)",
          "unit": "kg",
          "format": "decimal"
        },
        {
          "id": "mass_reduction_percent",
          "label": "Mass Reduction Percentage",
          "formula": "((inputs.initial_mass * (inputs.initial_water_content - inputs.final_water_content) / 100) / inputs.initial_mass) * 100",
          "unit": "%",
          "format": "decimal"
        }
      ]
    }

            },
            {
              "label": "Ammonia",
              "value": "ammonia"
            },
            {
              "label": "Acetone",
              "value": "acetone"
            },
            {
              "label": "Benzene",
              "value": "benzene"
            },
            {
              "label": "Iron",
              "value": "iron"
            },
            {
              "label": "Copper",
              "value": "copper"
            },
            {
              "label": "Aluminum",
              "value": "aluminum"
            },
            {
              "label": "Lead",
              "value": "lead"

        {
          "id": "freezing_point_celsius",
          "label": "Freezing Point",
          "unit": "°C",
          "format": "decimal",
          "formula": "0"
        },
        {
          "id": "melting_point_kelvin",
          "label": "Melting Point",
          "unit": "K",
          "format": "decimal",
          "formula": "273.15"

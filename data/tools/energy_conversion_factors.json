{
  "id": "energy_conversion_factors",
  "title": "Energy Conversion Factors",
  "description": "A tool for converting between different energy units and calculating energy conversion factors. Use this tool to quickly convert energy values between various measurement systems.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "content": "Energy Conversion Calculator",
      "inputs": [
        {
          "id": "energy_value",
          "label": "Energy Value",
          "type": "number",
          "defaultValue": 1,
          "unit": "kJ"
        },
        {
          "id": "from_unit",
          "label": "From Unit",
          "type": "select",
          "defaultValue": "kJ",
          "options": [
            {
              "label": "Kilojoules (kJ)",
              "value": "kJ"
            },
            {
              "label": "Megajoules (MJ)",
              "value": "MJ"
            },
            {
              "label": "Kilocalories (kcal)",
              "value": "kcal"
            },
            {
              "label": "Kilowatt-hours (kWh)",
              "value": "kWh"
            },
            {
              "label": "British Thermal Units (BTU)",
              "value": "BTU"
            }
          ]
        },
        {
          "id": "to_unit",
          "label": "To Unit",
          "type": "select",
          "defaultValue": "kcal",
          "options": [
            {
              "label": "Kilojoules (kJ)",
              "value": "kJ"
            },
            {
              "label": "Megajoules (MJ)",
              "value": "MJ"
            },
            {
              "label": "Kilocalories (kcal)",
              "value": "kcal"
            },
            {
              "label": "Kilowatt-hours (kWh)",
              "value": "kWh"
            },
            {
              "label": "British Thermal Units (BTU)",
              "value": "BTU"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "converted_value",
          "label": "Converted Value",
          "formula": "inputs.energy_value * 0.239",
          "unit": "variable",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "content": "Common Energy Conversion Factors",
      "headers": [
        "From Unit",
        "To Unit",
        "Conversion Factor"
      ],
      "rows": [

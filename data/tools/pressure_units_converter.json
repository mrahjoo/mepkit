{
  "id": "pressure_units_converter",
  "title": "Pressure Units Converter",
  "description": "Convert gas pressures between kPa, psi, inches of water, and inches of mercury",
  "type": "calculator",
  "components": [
    {
      "type": "markdown",
      "content": "# Pressure Units Converter\n\nConvert from kPa to psi and inches of Water and Mercury.\n\n**Supported Units:**\n- kPa (Kilopascals)\n- psi (Pounds per square inch)\n- inH₂O (Inches of Water)\n- inHg (Inches of Mercury)"
    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "pressure_kpa",
          "label": "Pressure (kPa)",
          "type": "number",
          "defaultValue": 1,
          "unit": "kPa"
        }
      ],
      "outputs": [
        {
          "id": "pressure_psi",
          "label": "Pressure (psi)",
          "formula": "inputs.pressure_kpa * 0.145038",
          "unit": "psi",
          "format": "decimal"
        },
        {
          "id": "pressure_in_water",
          "label": "Pressure (inches of water)",
          "formula": "inputs.pressure_kpa * 4.01865",
          "unit": "inH₂O",
          "format": "decimal"
        },
        {
          "id": "pressure_in_mercury",
          "label": "Pressure (inches of mercury)",
          "formula": "inputs.pressure_kpa * 0.295300",
          "unit": "inHg",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",

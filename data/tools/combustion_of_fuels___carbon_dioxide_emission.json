{
  "id": "combustion_of_fuels___carbon_dioxide_emission",
  "title": "Combustion of Fuels - Carbon Dioxide Emission",
  "description": "Calculate CO2 emission from fuel combustion using carbon content and energy content. Formula: qCO2 = (cf / hf) × (MCO2 / MC), where qCO2 is specific CO2 emission (kgCO2/kWh), cf is specific carbon content (kgC/kgfuel), hf is specific energy content (kWh/kgfuel), MCO2 is molecular weight of CO2 (44), and MC is molecular weight of Carbon (12).",
  "type": "calculator",
  "components": [
    {
      "type": "calculator",
      "content": "CO2 Emission Calculator",
      "inputs": [
        {
          "id": "carbon_content",
          "label": "Specific Carbon Content (cf)",
          "type": "number",
          "unit": "kgC/kgfuel",
          "defaultValue": 0.86
        },
        {
          "id": "energy_content",
          "label": "Specific Energy Content (hf)",
          "type": "number",
          "unit": "kWh/kgfuel",
          "defaultValue": 12.7
        },
        {
          "id": "fuel_type",
          "label": "Fuel Type (Reference)",
          "type": "select",
          "options": [
            {
              "label": "Methane (Natural Gas)",
              "value": "methane"
            },
            {
              "label": "Propane",
              "value": "propane"
            },
            {
              "label": "Butane",
              "value": "butane"
            },
            {
              "label": "LPG",
              "value": "lpg"
            },
            {
              "label": "Gasoline",
              "value": "gasoline"
            },
            {
              "label": "Kerosene (Jet)",
              "value": "kerosene"
            },
            {
              "label": "Diesel",
              "value": "diesel"
            },
            {
              "label": "Heavy Fuel Oil",
              "value": "heavy_fuel_oil"
            },
            {
              "label": "Petroleum Coke",
              "value": "petroleum_coke"
            },
            {
              "label": "Anthracite",
              "value": "anthracite"
            },
            {
              "label": "Bituminous Coal",
              "value": "bituminous"
            },
            {
              "label": "Subbituminous Coal",
              "value": "subbituminous"
            },
            {
              "label": "Lignite",
              "value": "lignite"
            },
            {
              "label": "Coke",
              "value": "coke"
            },
            {
              "label": "Peat (dry)",
              "value": "peat"
            },
            {
              "label": "Ethanol Fuel (E100)",
              "value": "ethanol"
            },
            {
              "label": "Methanol Fuel (M100)",
              "value": "methanol"
            },
            {
              "label": "Biodiesel (B100)",
              "value": "biodiesel"
            },
            {
              "label": "Wood",
              "value": "wood"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "co2_emission_kwh",
          "label": "CO2 Emission (Energy Basis)",
          "formula": "(inputs.carbon_content / inputs.energy_content) * (44 / 12)",
          "unit": "kgCO2/kWh",
          "format": "decimal"
        },
        {
          "id": "co2_emission_fuel",
          "label": "CO2 Emission (Fuel Basis)",
          "formula": "inputs.carbon_content * (44 / 12)",
          "unit": "kgCO2/kgfuel",
          "format": "decimal"
        },
        {
          "id": "molecular_ratio",
          "label": "Molecular Weight Ratio (MCO2/MC)",
          "formula": "44 / 12",
          "unit": "ratio",
          "format": "decimal"
        }
      ]
    },
    {

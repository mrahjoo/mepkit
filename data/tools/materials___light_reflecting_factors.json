    },
    {
      "type": "calculator",
      "inputs": [
        {
          "id": "material_reflectance",
          "label": "Material Reflectance Factor",
          "type": "number",
          "defaultValue": 50,
          "unit": "%"
        },
        {
          "id": "incident_radiation",
          "label": "Incident Solar Radiation",
          "type": "number",
          "defaultValue": 1000,
          "unit": "W/m²"
        }
      ],
      "outputs": [
        {
          "id": "reflected_radiation",
          "label": "Reflected Solar Radiation",
          "formula": "inputs.incident_radiation * inputs.material_reflectance / 100",
          "unit": "W/m²",
          "format": "decimal"
        },
        {
          "id": "absorbed_radiation",
          "label": "Absorbed Solar Radiation",
          "formula": "inputs.incident_radiation * (100 - inputs.material_reflectance) / 100",
          "unit": "W/m²",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "chart",
      "options": {
        "title": {
          "text": "Material Reflectance Comparison",
          "subtext": "Light Reflecting Factors by Material Category"
        },
        "tooltip": {

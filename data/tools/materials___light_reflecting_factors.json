          "axisPointer": {
            "type": "shadow"
          }
        },
        "grid": {
          "left": "3%",
          "right": "4%",
          "bottom": "3%",
          "containLabel": true
        },
        "xAxis": {
          "type": "category",
          "data": [
            "Metals",
            "Paint",
            "Coatings",
            "Natural Materials",
            "Extreme Cases"
          ],
          "axisLabel": {
            "interval": 0,
            "rotate": 45

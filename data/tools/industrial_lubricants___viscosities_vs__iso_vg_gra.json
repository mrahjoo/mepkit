{
  "id": "industrial_lubricants___viscosities_vs__iso_vg_gra",
  "title": "Industrial Lubricants - Viscosities vs. ISO-VG Grade",
  "description": "ISO-VG viscosity grades for industrial lubricants. Convert between ISO-VG grades and equivalent SAE crankcase oil, aircraft oil, gear lube, and AGMA grades. Calculate absolute viscosity conversions between temperature scales and viscosity units.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "content": "Temperature and Viscosity Unit Conversions",
      "inputs": [
        {
          "id": "temperature_fahrenheit",
          "label": "Temperature (Fahrenheit)",
          "type": "number",
          "defaultValue": 40,
          "unit": "°F"
        },
        {
          "id": "temperature_celsius",
          "label": "Temperature (Celsius)",
          "type": "number",
          "defaultValue": 4.44,
          "unit": "°C"
        },
        {
          "id": "viscosity_centistoke",
          "label": "Viscosity (centiStoke)",
          "type": "number",
          "defaultValue": 46,
          "unit": "cSt"
        },
        {
          "id": "viscosity_centipoise",
          "label": "Viscosity (centiPoise)",
          "type": "number",
          "defaultValue": 46,
          "unit": "cP"
        },
        {
          "id": "specific_gravity",
          "label": "Specific Gravity of Oil",
          "type": "number",
          "defaultValue": 0.9,
          "unit": ""
        },
        {
          "id": "viscosity_reyns",
          "label": "Viscosity (Reyns)",
          "type": "number",
          "defaultValue": 0.0067,
          "unit": "lb s/in²"
        }
      ],
      "outputs": [
        {
          "id": "celsius_from_fahrenheit",
          "label": "Temperature (Celsius)",
          "formula": "inputs.temperature_fahrenheit * 5/9 - 32 * 5/9",
          "unit": "°C",
          "format": "decimal"
        },
        {
          "id": "fahrenheit_from_celsius",
          "label": "Temperature (Fahrenheit)",
          "formula": "inputs.temperature_celsius * 9/5 + 32",
          "unit": "°F",
          "format": "decimal"
        },
        {
          "id": "centipoise_from_centistoke",
          "label": "Viscosity (centiPoise)",
          "formula": "inputs.viscosity_centistoke * inputs.specific_gravity",
          "unit": "cP",
          "format": "decimal"
        },
        {
          "id": "centistoke_from_centipoise",
          "label": "Viscosity (centiStoke)",
          "formula": "inputs.viscosity_centipoise / inputs.specific_gravity",
          "unit": "cSt",
          "format": "decimal"
        },
        {
          "id": "pascals_from_reyns",
          "label": "Viscosity (Pascal-Seconds)",
          "formula": "inputs.viscosity_reyns * 6896.55",
          "unit": "Pa·s",
          "format": "decimal"
        },
        {
          "id": "reyns_from_pascals",
          "label": "Viscosity (Reyns)",
          "formula": "inputs.viscosity_reyns",
          "unit": "lb s/in²",
          "format": "scientific"
        }
      ]
    },

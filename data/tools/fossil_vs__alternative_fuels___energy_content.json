{
  "id": "fossil_vs__alternative_fuels___energy_content",
  "title": "Fossil vs. Alternative Fuels - Energy Content",
  "description": "Calculate and compare energy content (calorific value) of various fossil and alternative fuels. Includes higher and lower heating values for gaseous, liquid, and solid fuels.",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "fuel_energy_calculator",
      "headers": [
        "Input Parameters",
        "Value"
      ],
      "content": "Calculate energy content and conversion between fuel types and energy units",
      "inputs": [
        {
          "id": "fuel_type",
          "label": "Fuel Type",
          "type": "select",
          "options": [
            {
              "label": "Natural gas (95% methane)",
              "value": "natural_gas_95"
            },
            {
              "label": "Natural gas (US marked)",
              "value": "natural_gas_us"
            },
            {
              "label": "Hydrogen",
              "value": "hydrogen"
            },
            {
              "label": "Still gas (refineries)",
              "value": "still_gas"
            },
            {
              "label": "Crude oil",
              "value": "crude_oil"
            },
            {
              "label": "Conventional gasoline",
              "value": "gasoline"
            },
            {
              "label": "Kerosene",
              "value": "kerosene"
            },
            {
              "label": "U.S. conventional diesel",
              "value": "diesel"
            },
            {
              "label": "LPG",
              "value": "lpg"
            },
            {
              "label": "LNG",
              "value": "lng"
            },
            {
              "label": "Ethanol",
              "value": "ethanol"
            },
            {
              "label": "Biodiesel",
              "value": "biodiesel"
            },
            {
              "label": "Petroleum coke",
              "value": "petcoke"
            },
            {
              "label": "Coal (bituminous)",
              "value": "coal_bituminous"
            },
            {
              "label": "Charcoal (wood)",
              "value": "charcoal"
            },
            {
              "label": "Wood (oak)",
              "value": "wood_oak"
            }
          ]
        },
        {
          "id": "amount",
          "label": "Amount",
          "type": "number",
          "defaultValue": 1,
          "unit": "kg or L"
        },
        {
          "id": "heating_value_type",
          "label": "Heating Value Type",
          "type": "select",
          "options": [
            {
              "label": "Gross (Higher) Heating Value (HHV)",
              "value": "hhv"
            },
            {
              "label": "Net (Lower) Heating Value (LHV)",
              "value": "lhv"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "energy_mj",
          "label": "Energy Content",
          "unit": "MJ",
          "formula": "inputs.amount * 45.0",
          "format": "decimal"
        },
        {
          "id": "energy_btu",
          "label": "Energy Content",
          "unit": "Btu",
          "formula": "inputs.energy_mj * 947.817",
          "format": "decimal"
        },
        {
          "id": "energy_kwh",
          "label": "Energy Content",
          "unit": "kWh",
          "formula": "inputs.energy_mj / 3.6",
          "format": "decimal"
        }
      ]
    },

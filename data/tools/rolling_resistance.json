{
  "id": "rolling_resistance",
  "title": "Rolling Resistance Calculator",
  "description": "Calculate the rolling resistance force based on the rolling resistance coefficient and weight of an object. Rolling resistance is the force that resists the motion of a body rolling on a surface.",
  "type": "calculator-chart",
  "components": [
    {
      "type": "calculator",
      "id": "rolling_resistance_calc",
      "headers": [
        "Rolling Resistance Calculator"
      ],
      "content": "Calculate rolling resistance using the formula: Fr = c × W, where W = m × g",
      "inputs": [
        {
          "id": "mass",
          "label": "Mass",
          "type": "number",
          "unit": "kg",
          "defaultValue": 1500
        },
        {
          "id": "rolling_coefficient",
          "label": "Rolling Resistance Coefficient (c)",
          "type": "number",
          "unit": "dimensionless",
          "defaultValue": 0.03
        },
        {
          "id": "gravity",
          "label": "Acceleration of Gravity",
          "type": "number",
          "unit": "m/s²",
          "defaultValue": 9.81
        }
      ],
      "outputs": [
        {
          "id": "weight",
          "label": "Weight (W)",
          "formula": "inputs.mass * inputs.gravity",
          "unit": "N",
          "format": "decimal"
        },
        {
          "id": "rolling_resistance_force",
          "label": "Rolling Resistance Force (Fr)",
          "formula": "inputs.rolling_coefficient * inputs.mass * inputs.gravity",
          "unit": "N",
          "format": "decimal"
        },
        {
          "id": "rolling_resistance_force_kn",
          "label": "Rolling Resistance Force (Fr)",
          "formula": "inputs.rolling_coefficient * inputs.mass * inputs.gravity / 1000",
          "unit": "kN",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "id": "rolling_coefficients_table",
      "headers": [
        "Surface/Material",

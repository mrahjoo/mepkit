{
  "id": "steel_flats___weights",
  "title": "Steel Flats - Weights",
  "description": "Typically weight of mild steel flats. Calculate the weight of a mild steel flat using W = 0.0075 w t, where W is weight (kg/m), w is flat width (mm), and t is flat thickness (mm).",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "content": "Steel Flats Weight Calculator",
      "inputs": [
        {
          "id": "width",
          "label": "Flat Width",
          "type": "number",
          "unit": "mm",
          "defaultValue": 50
        },
        {
          "id": "thickness",
          "label": "Flat Thickness",
          "type": "number",
          "unit": "mm",
          "defaultValue": 10
        }
      ],
      "outputs": [
        {
          "id": "weight",
          "label": "Weight",
          "unit": "kg/m",
          "formula": "0.0075 * inputs.width * inputs.thickness",
          "format": "decimal"
        }
      ]
    },

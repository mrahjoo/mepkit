{
  "id": "air_properties___thermal_conductivity_vs__temperat",
  "title": "Air Properties - Thermal Conductivity vs. Temperature",
  "description": "Calculate air thermal conductivity at given temperature and pressure. Thermal conductivity describes the ability to conduct heat and is expressed in multiple unit systems including W/(m K), Btu/(h ft °F), and kcal(IT)/(h m K).",
  "type": "calculator-table",
  "components": [
    {
      "type": "calculator",
      "id": "thermal_conductivity_calc",
      "content": "Air Thermal Conductivity Calculator",
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 25,
          "unit": "°C"
        },
        {
          "id": "temperature_unit",
          "label": "Temperature Unit",
          "type": "select",
          "defaultValue": "celsius",
          "options": [
            {
              "label": "Celsius (°C)",
              "value": "celsius"
            },
            {
              "label": "Fahrenheit (°F)",
              "value": "fahrenheit"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "thermal_conductivity_mw",
          "label": "Thermal Conductivity",
          "formula": "inputs.temperature * 0.2636 + 24.36",
          "unit": "mW/(m K)",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity_kcal",
          "label": "Thermal Conductivity",
          "formula": "inputs.temperature * 0.000227 + 0.02094",
          "unit": "kcal(IT)/(h m K)",
          "format": "decimal"
        },
        {
          "id": "thermal_conductivity_btu",
          "label": "Thermal Conductivity",
          "formula": "inputs.temperature * 0.0001527 + 0.01407",
          "unit": "Btu(IT)/(h ft °F)",
          "format": "decimal"
        }
      ]
    },

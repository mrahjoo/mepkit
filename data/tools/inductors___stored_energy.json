{
  "id": "inductors___stored_energy",
  "title": "Inductors - Stored Energy",
  "description": "Energy stored in a magnetic field of an inductor",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "headers": [
        "Input",
        "Value",
        "Unit"
      ],
      "inputs": [
        {
          "id": "inductance",
          "label": "Inductance (L)",
          "type": "number",
          "unit": "H",
          "defaultValue": 10
        },
        {
          "id": "current",
          "label": "Current (I)",
          "type": "number",
          "unit": "A",
          "defaultValue": 5
        }
      ],
      "outputs": [
        {
          "id": "energy",
          "label": "Energy Stored (W)",
          "unit": "J",
          "format": "decimal",
          "formula": "0.5 * inputs.inductance * inputs.current * inputs.current"
        }
      ]
    },

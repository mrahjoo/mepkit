          "label": "Acceleration of Gravity",
          "type": "number",
          "unit": "m/s²",
          "defaultValue": 9.81
        }
      ],
      "outputs": [
        {
          "id": "safe_mass_kg",
          "label": "Maximum Safe Mass",
          "formula": "(inputs.safe_load_kn * 1000) / inputs.gravity",

          "label": "Minor Diameter",
          "formula": "inputs.nominal_diameter - (2 * inputs.pitch * 0.614)",
          "unit": "mm",
          "format": "decimal"
        },
        {
          "id": "pitch_diameter",
          "label": "Pitch Diameter",
          "formula": "inputs.nominal_diameter - (inputs.pitch * 0.614)",

{
  "id": "carbon_dioxide___thermal_conductivity_vs__temperat",
  "title": "Carbon Dioxide - Thermal Conductivity vs. Temperature and Pressure",
  "description": "Thermal conductivity calculator for carbon dioxide at given temperatures and pressures. Thermal conductivity is the ability of a material to conduct heat, measured in W/(m K) or other units. This tool provides thermal conductivity values for CO2 in various states (gas, liquid, supercritical) across different temperature and pressure conditions.",
  "type": "chart",
  "components": [
    {
      "type": "calculator",
      "id": "co2_thermal_conductivity_calc",
      "headers": [
        "Input Parameters",
        "Output Values"
      ],
      "inputs": [
        {
          "id": "temperature",
          "label": "Temperature",
          "type": "number",
          "defaultValue": 300,
          "unit": "K"
        },
        {
          "id": "pressure",
          "label": "Pressure",
          "type": "number",
          "defaultValue": 1,
          "unit": "bara"
        },
        {
          "id": "temp_unit",
          "label": "Temperature Unit",
          "type": "select",
          "defaultValue": "K",
          "options": [
            {
              "label": "Kelvin (K)",
              "value": "K"
            },
            {
              "label": "Celsius (°C)",
              "value": "C"
            },
            {
              "label": "Fahrenheit (°F)",
              "value": "F"
            },
            {
              "label": "Rankine (°R)",
              "value": "R"
            }
          ]
        },
        {
          "id": "pressure_unit",
          "label": "Pressure Unit",
          "type": "select",
          "defaultValue": "bara",
          "options": [
            {
              "label": "bara",
              "value": "bara"
            },
            {
              "label": "MPa",
              "value": "MPa"
            },
            {
              "label": "psia",
              "value": "psia"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "thermal_cond_mW_mK",
          "label": "Thermal Conductivity",
          "unit": "mW/(m·K)",
          "format": "decimal",
          "formula": "inputs.temperature"
        },
        {
          "id": "thermal_cond_kcal",
          "label": "Thermal Conductivity",
          "unit": "kcal(IT)/(h·m·K)",
          "format": "decimal",
          "formula": "inputs.temperature * 0.00086"
        },
        {
          "id": "thermal_cond_btu_ft",
          "label": "Thermal Conductivity",
          "unit": "Btu(IT)/(h·ft·°F)",
          "format": "decimal",
          "formula": "inputs.temperature * 0.0005779"
        },
        {
          "id": "thermal_cond_btu_in",
          "label": "Thermal Conductivity",
          "unit": "(Btu(IT)·in)/(h·ft²·°F)",
          "format": "decimal",
          "formula": "inputs.temperature * 0.006933"
        }
      ],
      "content": "Enter the temperature and pressure of carbon dioxide to calculate its thermal conductivity in multiple units."
    },

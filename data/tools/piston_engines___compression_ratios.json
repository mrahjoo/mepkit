{
  "id": "piston_engines___compression_ratios",
  "title": "Piston Engines - Compression Ratios",
  "description": "Cylinder volume and compression ratios in piston engines. Calculate the static compression ratio using piston displacement volume and clearance volume.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "id": "compression_ratio_calculator",
      "headers": [
        "Compression Ratio Calculator"
      ],
      "content": "Calculate the compression ratio CR = (Vd + Vc) / Vc where Vd = π d² s / 4",
      "inputs": [
        {
          "id": "piston_diameter",
          "label": "Piston Diameter (d)",
          "type": "number",
          "unit": "cm",
          "defaultValue": 8
        },
        {
          "id": "piston_stroke",
          "label": "Piston Stroke (s)",
          "type": "number",
          "unit": "cm",
          "defaultValue": 10
        },
        {
          "id": "clearance_volume",
          "label": "Clearance Volume (Vc)",
          "type": "number",
          "unit": "cm³",
          "defaultValue": 50
        }
      ],
      "outputs": [
        {
          "id": "displacement_volume",
          "label": "Piston Displacement Volume (Vd)",
          "formula": "(3.14159 * inputs.piston_diameter ^ 2 * inputs.piston_stroke) / 4",
          "unit": "cm³",
          "format": "decimal"
        },
        {
          "id": "total_volume",
          "label": "Total Volume (Vd + Vc)",
          "formula": "((3.14159 * inputs.piston_diameter ^ 2 * inputs.piston_stroke) / 4) + inputs.clearance_volume",
          "unit": "cm³",
          "format": "decimal"
        },
        {
          "id": "compression_ratio",
          "label": "Compression Ratio (CR)",
          "formula": "(((3.14159 * inputs.piston_diameter ^ 2 * inputs.piston_stroke) / 4) + inputs.clearance_volume) / inputs.clearance_volume",
          "unit": "",
          "format": "decimal"
        }
      ]
    },
    {

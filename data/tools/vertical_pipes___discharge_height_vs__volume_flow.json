{
  "id": "vertical_pipes___discharge_height_vs__volume_flow",
  "title": "Vertical Pipes - Discharge Height vs. Volume Flow",
  "description": "Calculate maximum vertical discharge height for water flow from vertical pipes and tubes. Includes both forward calculation (flow to height) and reverse calculation (height to flow) using the trajectory method.",
  "type": "chart-table",
  "components": [
    {
      "type": "calculator",
      "content": "Calculate Discharge Height from Volume Flow",
      "inputs": [
        {
          "id": "flow_gpm",
          "label": "Volume Flow",
          "type": "number",
          "unit": "gpm",
          "defaultValue": 529
        },
        {
          "id": "pipe_diameter",
          "label": "Pipe Diameter",
          "type": "number",
          "unit": "inches",
          "defaultValue": 4
        },
        {
          "id": "coefficient_k",
          "label": "Coefficient k",
          "type": "number",
          "defaultValue": 0.97
        }
      ],
      "outputs": [
        {
          "id": "discharge_height",
          "label": "Discharge Height",
          "formula": "Math.pow(inputs.flow_gpm / (5.68 * inputs.coefficient_k * Math.pow(inputs.pipe_diameter, 2)), 2)",
          "unit": "inches",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "calculator",
      "content": "Measure Flow by Discharge Height (Reverse Calculation)",
      "inputs": [
        {
          "id": "discharge_height_meas",
          "label": "Measured Discharge Height",
          "type": "number",
          "unit": "inches",
          "defaultValue": 36
        },
        {
          "id": "pipe_diameter_meas",
          "label": "Pipe Diameter",
          "type": "number",
          "unit": "inches",
          "defaultValue": 4
        },
        {
          "id": "coefficient_k_meas",
          "label": "Coefficient k",
          "type": "number",
          "defaultValue": 0.97
        }
      ],
      "outputs": [
        {
          "id": "volume_flow_measured",
          "label": "Volume Flow",
          "formula": "5.68 * inputs.coefficient_k_meas * Math.pow(inputs.pipe_diameter_meas, 2) * Math.pow(inputs.discharge_height_meas, 0.5)",
          "unit": "gpm",
          "format": "decimal"
        }
      ]
    },
    {
      "type": "datatable",
      "content": "Discharge Height Reference Table",
      "headers": [
        "Pipe Diameter (in)",

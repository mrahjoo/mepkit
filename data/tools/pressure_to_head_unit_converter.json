            },
            {
              "value": "kg_cm2",
              "label": "kg/cm²"
            },
            {
              "value": "kg_m2",
              "label": "kg/m²"
            },
            {
              "value": "in_water",
              "label": "in. water (68°F)"
            },
            {
              "value": "ft_water",
              "label": "ft. water (68°F)"
            },
            {
              "value": "in_mercury",
              "label": "in. mercury (31°F)"
            },
            {
              "value": "mm_mercury",
              "label": "mm mercury (31°F)"
            },
            {
              "value": "bars",
              "label": "Bars"
            },
            {
              "value": "mpa",
              "label": "MPa"
            }
          ]
        },
        {
          "id": "toUnit",
          "label": "To Unit",
          "type": "select",
          "options": [
            {
              "value": "lb_in2",
              "label": "lb/in²"
            },
            {
              "value": "lb_ft2",
              "label": "lb/ft²"
            },
            {
              "value": "atm",
              "label": "Atm"
            },
            {
              "value": "kg_cm2",
              "label": "kg/cm²"
            },
            {
              "value": "kg_m2",
              "label": "kg/m²"
            },
            {
              "value": "in_water",
              "label": "in. water (68°F)"
            },
            {
              "value": "ft_water",
              "label": "ft. water (68°F)"
            },
            {
              "value": "in_mercury",
              "label": "in. mercury (31°F)"
            },
            {
              "value": "mm_mercury",
              "label": "mm mercury (31°F)"
            },
            {
              "value": "bars",
              "label": "Bars"
            },
            {
              "value": "mpa",
              "label": "MPa"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "result",
          "label": "Converted Value",
          "formula": "inputs.inputValue * (inputs.fromUnit === 'lb_in2' && inputs.toUnit === 'mpa' ? 0.006895 : inputs.fromUnit === 'in_mercury' && inputs.toUnit === 'mpa' ? 0.0033864 : inputs.fromUnit === 'atm' && inputs.toUnit === 'mpa' ? 0.101325 : inputs.fromUnit === 'bars' && inputs.toUnit === 'mpa' ? 0.1 : inputs.fromUnit === 'kg_cm2' && inputs.toUnit === 'mpa' ? 0.098067 : inputs.fromUnit === 'lb_in2' && inputs.toUnit === 'bars' ? 14.5038 : inputs.fromUnit === 'lb_in2' && inputs.toUnit === 'atm' ? 0.068046 : inputs.fromUnit === 'in_mercury' && inputs.toUnit === 'bars' ? 0.033864 : 1)",
